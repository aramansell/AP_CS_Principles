---
// CED Coverage Matrix — rebuilt at every `npm run build` from
// src/data/curriculum.ts.
import Base from '../../layouts/BaseLayout.astro';
import { SEQUENCE, CED_TOPICS, firstTeaching, shortDate } from '../../data/curriculum';

const BIG_IDEA: Record<string, string> = {
  'CRD': 'Big Idea 1: Creative Development',
  'DAT': 'Big Idea 2: Data',
  'AAP': 'Big Idea 3: Algorithms & Programming',
  'CSN': 'Big Idea 4: Computer Systems & Networks',
  'IOC': 'Big Idea 5: Impact of Computing',
};
const topics = Object.keys(CED_TOPICS).sort();
const unitOf = (t: string) => BIG_IDEA[t.split('-')[0]] ?? t;

// count B-days per phase for the weighting table
const phaseDays = new Map<number, number>();
for (const e of SEQUENCE) phaseDays.set(e.phase, (phaseDays.get(e.phase) ?? 0) + 1);
---
<Base title="CED Coverage Matrix — AP CS Principles" active="docs" root=".." docsHome="index.html" css="style.css"
  description="How this Unity course covers all 10 AP CSP CED topic families — mapped lesson by lesson.">
<h1>CED Coverage Matrix</h1>

<p>
    Every required topic family of the AP Computer Science Principles Course
    and Exam Description (Fall 2023 CED, current), mapped to when we teach it
    and with what. {topics.length} of {topics.length} topic families covered.
    The Unity build (Units 1-8) carries Algorithms &amp; Programming and the
    program-development half of Creative Development; Unit 9 exists because
    a year in Unity alone cannot teach you binary, networks, or impact —
    and the exam asks about all three.
</p>

<table>
    <tr><th>Topic</th><th>Title</th><th>Big idea</th><th>First taught</th><th>Lessons</th></tr>
    {topics.map((t) => {
        const e = firstTeaching(t);
        if (!e) throw new Error('CED topic ' + t + ' is never taught in SEQUENCE');
        return (
        <tr>
            <td><strong>{t}</strong></td>
            <td>{CED_TOPICS[t]}</td>
            <td>{unitOf(t)}</td>
            <td>{shortDate(e.d)}</td>
            <td>{e.lessons.length ? e.lessons.join(', ') : '—'}</td>
        </tr>
        );
    })}
</table>

<h2>Weighting Check</h2>

<p>
    Where the AP score comes from: the end-of-course exam (70%) — 70
    multiple-choice questions in 120 minutes plus two written-response
    questions in 60 minutes, all in Bluebook — and the Create performance
    task (30%), due April 30. The MC section weights the five big ideas like
    this, and here is how our calendar spends its days:
</p>

<table>
    <tr><th>Big idea</th><th>Exam weight (MC)</th><th>Where we teach it</th><th>B-days</th></tr>
    <tr><td>1: Creative Development</td><td>10-13%</td><td>All year ( jams, Create PT) + 9.10</td><td>woven</td></tr>
    <tr><td>2: Data</td><td>17-22%</td><td>Unit 9 (9.1-9.6a)</td><td>6</td></tr>
    <tr><td>3: Algorithms &amp; Programming</td><td>30-35%</td><td>Units 1-8 + card jam (10.2a-d)</td><td>{(phaseDays.get(1) ?? 0) + (phaseDays.get(2) ?? 0)}</td></tr>
    <tr><td>4: Computer Systems &amp; Networks</td><td>11-15%</td><td>Unit 9 (9.7-9.9a)</td><td>3</td></tr>
    <tr><td>5: Impact of Computing</td><td>21-26%</td><td>Unit 9 (9.6a, 9.10a) + jam retros</td><td>2 + woven</td></tr>
</table>

<p>
    Algorithms &amp; Programming is the heaviest exam weight and it gets the
    most calendar by design: every single class of first semester is a lab
    that programs something real. Data and Systems get a dedicated,
    concentrated January-February unit so they are fresh (but not too fresh)
    in May, and the exam sprint re-touches everything in weight order.
</p>
</Base>
