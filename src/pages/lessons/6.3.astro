// PlayerController.cs — the jump, and the four numbers that make it feel like
// yours. Movement 1.4, animation 1.6, the velocity rule 2.2, the launch from
// 6.1, the ground check from 6.2 — and the two mercies.
public class PlayerController : MonoBehaviour
{
    [SerializeField] private float moveSpeed = 5f;
    [SerializeField] private float jumpForce = 7f;          // yours already — 6.1's step 1

    // ---- the four numbers this lesson is about --------------------------
    [SerializeField] private float fallMultiplier = 2.5f;   // heavier going down
    [SerializeField] private float riseCut = 0.5f;          // release shortens the rise
    [SerializeField] private float coyoteTime = 0.1f;       // grace after the ledge
    [SerializeField] private float jumpBufferTime = 0.12f;  // grace before the floor

    // ---- your 6.2 check, unchanged. This file writes the raycast row; if you
    // picked a different one, CheckGround() is the only place that changes. ---
    [SerializeField] private float groundDistance = 0.6f;
    [SerializeField] private LayerMask groundMask;

    private Rigidbody2D body;
    private float baseGravity;          // read once, so the Inspector still owns it

    private bool isGrounded;
    private float lastGroundedTime;     // a MOMENT, not a count
    private float lastJumpPressedTime;  // the other moment, a different field

    void Start()
    {
        body = GetComponent<Rigidbody2D>();

        // ... your 6.1 gravity line, if you wrote one for the scene ...
        baseGravity = body.gravityScale;    // read it LAST — after your 6.1 gravity line above
    }

    void Update()
    {
        // ... your input, movement and animation from 1.4, 1.6 and 2.2 ...
        CheckGround();

        // The memory: refreshed on every frame the feet are down.
        if (isGrounded)
        {
            lastGroundedTime = Time.time;
        }

        // The other memory: written by the key, on the frame it goes down.
        if (Input.GetKeyDown(KeyCode.Space))
        {
            lastJumpPressedTime = Time.time;
        }

        // The same subtraction twice, asked in opposite directions.
        bool stillInGrace = Time.time - lastGroundedTime <= coyoteTime;
        bool pressedRecently = Time.time - lastJumpPressedTime <= jumpBufferTime;

        if (pressedRecently && (isGrounded || stillInGrace))
        {
            Jump();
        }

        // The fourth number: let go early and the rise is cut short.
        if (Input.GetKeyUp(KeyCode.Space) && body.linearVelocity.y > 0f)
        {
            body.linearVelocity = new Vector2(body.linearVelocity.x, body.linearVelocity.y * riseCut);
        }
    }

    // Gravity is a value the physics engine reads, so it is written on the
    // physics clock: fifty times a second here, whatever the frame rate is.
    void FixedUpdate()
    {
        if (body.linearVelocity.y < 0f)
        {
            body.gravityScale = baseGravity * fallMultiplier;
        }
        else
        {
            body.gravityScale = baseGravity;
        }
    }

    private void Jump()
    {
        // Your launch from 6.1: one flick. Writing linearVelocity directly
        // works identically here — the Kinematic MovePosition row does not,
        // because a Kinematic body has no gravity for the fall branch to fight.
        body.AddForce(Vector2.up * jumpForce, ForceMode2D.Impulse);

        // Spend both windows. A window that is never closed is a jetpack —
        // and unlike the turret's cooldown, this one cannot close itself.
        lastGroundedTime = -999f;
        lastJumpPressedTime = -999f;
    }

    private void CheckGround()
    {
        // A RaycastHit2D is true when the ray hit something and false when it
        // did not, so it stores straight into the bool. Your 6.2 technique,
        // whichever of the four you chose, belongs on this line.
        isGrounded = Physics2D.Raycast(transform.position, Vector2.down, groundDistance, groundMask);
    }
}`,
  finalNote:
    'Compare against your own file rather than copying it. Three things have to match and nothing else does: the fall multiplier is written on the physics clock and **restored on the way up**, the jump is gated by two windows rather than by the ground check alone, and **both windows are spent the instant the jump fires**. Your launch, your ground check, your names and all four of your numbers are yours.',
};

const body = `<h1>6.3 — Jump Feel: Fall Speed &amp; Coyote Time</h1>

<p class="lesson-lead">
    The jump works, the ground check is honest, and the character still comes down like a balloon.
    "Feel" is four numbers with names, and every platformer you have ever called <em>tight</em> is
    using all four.
</p>

${renderAskBanner('how do I make my jump feel good?', 2)}

${renderDecompose('6.3', DECOMPOSE, 2)}

<!-- ============================================================ -->
<div class="activity discovery">
    <div class="activity-header">
        <span class="activity-label">In the Editor</span>
        <span class="activity-time">~25 min</span>
    </div>

    <ol>
        <li>
            <strong>Project window →</strong> open <code>Assets/_Scenes/Platformer.unity</code>, then
            <strong>Game view →</strong> press Play and play for thirty seconds with your attention
            on your hands rather than the screen. Three complaints come up, and they are the three
            every playtester in the world reports:
            <ul>
                <li><em>"I float down like a balloon."</em> One gravity number, doing two jobs.</li>
                <li><em>"It ate my jump at the ledge."</em> A press made one step past the lip is
                refused.</li>
                <li><em>"It ignored my press just before I landed."</em> The press arrives while you
                are airborne, and nothing is listening.</li>
            </ul>
        </li>
        <li>
            <strong>Hierarchy → the Player → Inspector → Rigidbody2D → Gravity Scale</strong>, and
            keep that row visible while you jump in <strong>Game view →</strong>. Watch it: it never
            changes while you play.
        </li>
        <li>
            <strong>Game view →</strong> walk off the lip of a ledge and press jump as late as you
            dare, then jump a fraction of a second <em>before</em> you land. Nothing happens either
            time. Both fixes are timers that remember a moment rather than counting anything.
        </li>
        <li>
            <strong>Once the walkthrough is done — Project window → Assets/Prefabs/Player →
            Inspector → Player Controller:</strong> four new rows. Tune them one at a time, in play
            mode, one sentence of feel written down for each.
            <ul>
                <li><strong>Fall Multiplier</strong> = <code>1</code> first, as your control — the
                balloon you started with. Then <code>2.5</code>, then <code>3</code>.</li>
                <li><strong>Coyote Time</strong> = <code>0.1</code>, then <code>0.5</code> — at
                <code>0.5</code> you can leave a ledge, decide about it, and jump anyway.</li>
                <li><strong>Jump Buffer Time</strong> = <code>0.12</code>, then <code>1</code> — at
                <code>1</code> a press made a full second early still fires, and every fall becomes
                a jump you did not ask for.</li>
                <li><strong>Rise Cut</strong> = <code>0.5</code>, then <code>0</code> — tap and
                hold side by side. <code>0.5</code> gives two visibly different jumps;
                <code>0</code> gives a tap that does nothing at all, which is a bug rather than a
                mechanic.</li>
            </ul>
        </li>
        <li>
            <strong>Prove the windows are state, not luck.</strong> Put
            <code>Debug.Log("grounded at " + lastGroundedTime + " now " + Time.time);</code> in
            <code>Update()</code> for one run and watch the two numbers as you walk off a ledge and
            land: the gap between them is your coyote window, live. Then <strong>delete the
            print</strong> — a log that survives into the next lesson is noise you will read past.
        </li>
    </ol>

    <div class="socratic">
        <h3>Socratic: Forgiving Intent Versus Playing For Them</h3>
        <ol>
<li>Coyote time and the jump buffer both let a press count when it "should not". Why does that make the player feel more in control, when technically it makes the game more permissive?</li>
<li>Set coyote time long enough and you can jump from thin air a metre past a ledge. What is the difference between forgiving the player's <em>intent</em> and playing the game for them?</li>
<li>Asymmetric gravity is a lie about physics, told by a multiplier on a law of the universe. What other lie does your character already tell — and what does each lie buy the player?</li>
<li>Which of the four knobs needs to know which way the body is <em>moving</em>, and which of them only need to know about <em>time</em>?</li>
</ol>
    </div>
</div>

<!-- ============================================================ -->
<div class="activity basic-app">
    <div class="activity-header">
        <span class="activity-label">In the Code</span>
        <span class="activity-time">~10 min</span>
    </div>

    <div class="callout info">
        <strong>Both mercies are the same subtraction you met in
        <a href="3.3.html">3.3</a>, read in the opposite direction</strong> — the same clock, the
        same remembered moment, the same knob, with the comparison turned around. Step 3's
        annotation works the operator out.
    </div>

    <div class="callout trap">
        <strong>A window is not a countdown — pick one idiom per field.</strong> 3.3 named two
        honest timers: a <em>timestamp</em> compared against <code>Time.time</code>, and a
        <em>countdown</em> with <code>Time.deltaTime</code> subtracted from it every frame. Both
        work. What does not work is one field doing both jobs: a number that means "when it
        happened" on the frame you write it and "how long is left" everywhere else has no correct
        comparison, and the bug looks like the window closing at the wrong moment. Today's two
        fields are both timestamps, because both of them answer questions about <em>when</em>.
    </div>
</div>

<!-- ============================================================ -->
${renderWalkthrough(WALK)}

<!-- ============================================================ -->
<div class="activity basic-app">
    <div class="activity-header">
        <span class="activity-label">Build Lab: Tune the Four Numbers</span>
        <span class="activity-time">~30 min</span>
    </div>

    <p>
        The walkthrough built the reference version of all four. What it cannot give you is the
        numbers, because they are the design — and each one is now an Inspector row.
    </p>

    <div class="callout">
        <strong>Architectural specification: the fall multiplier.</strong>
        <ul>
            <li>Where does the "normal" gravity number live in <em>your</em> project — a literal in your own code, a serialized field, a scene-instance value, or a value you read off the body? Whatever the answer, you now need it in a second place, and that is a design smell worth fixing rather than living with.</li>
            <li>Is the value you multiply <em>your own field</em> or the body's <code>gravityScale</code>? Which choice survives a teammate retuning the cave in the Inspector?</li>
            <li>What happens in the top-down Overworld if this branch runs there? Before you answer,
            look at the Player in <em>that</em> scene and read the Gravity Scale that is actually
            there rather than the one you remember setting.</li>
        </ul>
    </div>

    <div class="callout">
        <strong>Architectural specification: the two mercies.</strong>
        <ul>
            <li>What exact moment does each field record, and which event writes it? Say it in one sentence per field, and use the word "moment" in both, not "timer".</li>
            <li>How long is each window, in seconds? Write your two numbers down beside a sentence of feel for each, the way you did for the jump force in <a href="6.1.html">6.1</a>.</li>
            <li>What is the "spend" rule — and can the same jump fire twice off one remembered press if you get it wrong? Which of the two windows does the double-fire come from?</li>
            <li>What is the initial value of each field before anything has happened — before the feet have touched the ground and before the key has ever been pressed? If it starts at <code>0</code> and the scene clock also starts near <code>0</code>, what does your first frame of play do?</li>
        </ul>
    </div>

    <div class="callout">
        <strong>Architectural specification: the fourth number.</strong>
        <ul>
            <li>When is the cut allowed? Only while rising, or on the way down too? What would a cut on the way down even mean?</li>
            <li>How does the cut interact with a buffered jump the player never held? Describe the two knobs fighting, then decide which one you would weaken.</li>
        </ul>
    </div>

    <div class="callout trap">
        <strong>Two timers and one jump key is how you build an infinite jump by accident.</strong>
        Watch the number you printed in the In the Editor steps. If it keeps resetting while you are
        nowhere near the floor, one of the two remembered moments is being refreshed when it should
        not be, or one of them is not being spent.
    </div>
</div>

<!-- ============================================================ -->

<div class="checklist">
    <h3>Checkpoint — before moving on, you must be able to:</h3>
    <ul>
        <li>Explain asymmetric gravity as a multiplier on the body's own value, applied on the physics clock</li>
        <li>Say where the "normal" gravity number lives, and why multiplying it beats storing a second copy</li>
        <li>Build coyote time and the jump buffer from the timestamp pattern in <a href="3.3.html">3.3</a>, and say which way the comparison turned</li>
        <li>Explain "spending" a window, and why a window read backwards cannot close itself the way a cooldown does</li>
        <li>Defend all four knobs as intent-forgiveness rather than difficulty-lowering</li>
        <li>Commit and push</li>
    </ul>
</div>

