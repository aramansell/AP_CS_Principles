import Lesson from '../../layouts/LessonLayout.astro';

const body = `<h1>11.5 — Exam Eve: Logistics &amp; Strategy</h1>

<p class="lesson-lead">
    The exam is May 14, 8:00 AM, Session 1, in Bluebook (the digital
    app — NOT pencil and paper). Tomorrow morning is logistics, not
    learning. Today we rehearse the day itself and step back to see
    the whole year's arc: from "what is a variable" to here.
</p>

<!-- ============================================================ -->
<div class="activity assessment">
    <div class="activity-header">
        <span class="activity-label">Logistics</span>
        <span class="activity-time">~20 min</span>
    </div>

    <p><strong>The exam-day contract (read aloud, twice):</strong></p>
    <ul>
        <li><strong>When:</strong> May 14, 8:00 AM — arrive at the
            exam room by 7:30 (PPS schedule; your teacher posts
            the room)</li>
        <li><strong>How:</strong> Bluebook app on school-managed
            devices — you have practiced in it during MC sets;
            bring your fully-charged school laptop AND your
            charger</li>
        <li><strong>What you may bring:</strong> your
            <strong>PPR</strong> (printed — it rides with you
            into the WR section), pens/pencils for scratch work,
            water. Phone: OFF in bag, per College Board rules —
            an accidental buzz is a score cancellation risk</li>
        <li><strong>Format:</strong> 70 MC in 120 minutes, then 4
            written responses in 60 minutes. One break between
            (eat something)</li>
    </ul>

    <p><strong>Tonight's actual homework (un-ironic):</strong></p>
    <ol>
        <li>Print the PPR. Check it against your submitted program
            one final time (<a href="11.2b.html">11.2b</a>
            cross-check).</li>
        <li>Skim the <a href="../exam/reference-sheet.html">reference
            sheet</a> ONCE, slowly. Then close everything.</li>
        <li>Sleep at a normal hour. The exam is 3 hours —
            exhaustion costs more points than any last-minute
            cram buys (<a href="11.4a.html">11.4a</a> taught you
            time economics; your brain is the budget).</li>
    </ol>

    <div class="socratic">
        <h3>Socratic</h3>
        <p>
            The best predictor of MC score is not last-night
            cramming but your error table's weak families
            (<a href="11.4c.html">11.4c</a>). If you have 60
            minutes tonight, split it: 20 on family drills, 20 on
            reference-sheet fluency, 20 on packing the bag.
            Why is "packing the bag" worth the same 20 minutes
            as studying (what does a forgotten charger do to a
            digital exam)?
        </p>
    </div>
</div>

<!-- ============================================================ -->
<div class="activity assessment">
    <div class="activity-header">
        <span class="activity-label">The Arc</span>
        <span class="activity-time">~15 min</span>
    </div>

    <p><strong>Look how far this is from September.</strong> Read
    the chain out loud — your whole year, one line each:</p>
    <ol>
        <li>First variable (<a href="1.3.html">1.3</a>) →
            movement (<a href="1.4.html">1.4</a>)</li>
        <li>First trigger coin (<a href="2.1.html">2.1</a>) →
            first death loop (<a href="2.2.html">2.2</a>)</li>
        <li>Turret radius (<a href="3.1.html">3.1</a>) → the
            cooldown pattern (<a href="3.3.html">3.3</a>) —
            used four times since</li>
        <li>Enemy state machine (<a href="4.5.html">4.5</a>) →
            the lever's events (<a href="5.2.html">5.2</a>)</li>
        <li>The cave switch (<a href="5.3.html">5.3</a>) → your
            jump feel (<a href="6.3.html">6.3</a>) → the whole
            big cave (<a href="7.5.html">7.5</a>)</li>
        <li>Your own boss (<a href="8.1.html">8.1</a>–<a href="8.6.html">8.6</a>)
            — "sorta your first on your own experience"</li>
        <li>The ideas underneath (<a href="9.1.html">9.1</a>–<a href="9.10.html">9.10</a>),
            the jams (<a href="10.1a.html">10.1a</a>–<a href="10.2f.html">10.2f</a>),
            and the Create PT (<a href="11.1a.html">11.1a</a>–<a href="11.2b.html">11.2b</a>)
            — already banked at College Board</li>
    </ol>
    <p>The exam asks you to prove it. You do not need luck; you
    need sleep. Go get it.</p>

    <div class="tinker">
        <h3>Tinker: The final commit</h3>
        <ol>
            <li>Check your bag: laptop + charger + PPR printed +
                water. <code>commit "11.5a: exam ready"</code> —
                then close the laptop, tomorrow it fights.</li>
        </ol>
    </div>

    <div class="checklist">
        <h3>Checkpoint — before moving on, you must be able to:</h3>
        <ul>
            <li>Recite exam logistics: May 14, 8 AM, Bluebook, PPR in hand</li>
            <li>Explain tonight's 20-20-20 split and why sleep is a strategy</li>
            <li>Narrate the year's arc in one breath per unit</li>
        </ul>
    </div>
</div>

<!-- ============================================================ -->
<div class="resources">
    <h3>Reference Docs</h3>
    <p>Need a deeper explanation? These pages cover the same concepts:</p>
    <ul>
        <li><a href="../exam/index.html">Exam Hub</a> — every date and rule in one place</li>
        <li><a href="../exam/mc-strategy.html">MC Strategy</a> — the three-pass plan one more time</li>
    </ul>
    <p>After the exam: <a href="12.1a.html">12.1a — Grid/Symmetry Jam: Kickoff</a> — the games keep coming.</p>
</div>`;
