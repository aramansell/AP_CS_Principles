const body = `<h1>4.5 — The Full State Machine: Patrol, Chase, Attack</h1>

<p class="lesson-lead">
    You have written every line of this enemy already: the patrol, the chase, the contact damage.
    What you do <em>not</em> have is a field saying which one it is doing right now — and that
    missing field is the difference between a pile of behaviours and a machine.
</p>

${renderAskBanner('how do I make an enemy switch between patrolling, chasing and attacking?', 2)}

${renderDecompose('4.5', DECOMPOSE, 2)}

<div class="activity discovery">
    <div class="activity-header">
        <span class="activity-label">In the Editor</span>
        <span class="activity-time">~20 min</span>
    </div>

    <ol>
        <li>
            <strong>Scene view →</strong> save the Overworld, then <strong>Project window →</strong>
