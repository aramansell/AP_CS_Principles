const body = `<h1>8.2 — Boss Body, Health &amp; Phases</h1>

<p class="lesson-lead">
    Your spec exists on paper (<a href="8.1.html">8.1</a>). Today it becomes an object standing
    in a room. But there is nothing to drag in: this project has no boss prefab, and if you
    search <code>Assets/Prefabs</code> for one you will come up empty. You are about to assemble
    a boss out of the enemy art that is already here, give it a shape the physics engine can
    find, give it a number that says how alive it is, and make that number change its mind at
    two thresholds. Health first, attacks in <a href="8.4.html">8.4</a> — a boss you cannot hurt
    is a boss you cannot tune.
</p>

${renderAskBanner('how do I build a boss when there is no boss prefab?', 3)}

${renderDecompose('8.2', DECOMPOSE, 3)}

<!-- ============================================================ -->
<div class="activity discovery">
    <div class="activity-header">
        <span class="activity-label">The Problem: Assembling Something From Parts That Are Not It</span>
        <span class="activity-time">~10 min</span>
    </div>

    <p>
