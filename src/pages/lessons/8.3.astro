// Lesson 8.3 — Boss Prototype II: Player Attacks & Hitbox
// Level 2 (Fill the Gap): aligns directly to PlayerController.cs's real combat setup!
// Uses `GameObject attackBox`, `GameObject currentEnemy`, `cooldownTimer`, `KeyCode.E`,
// and `KeyCode.Space` spawning `PlayerProjectile` with `SetDirection(facing)`.
// NO OverlapBoxAll, NO TakeDamage, NO spriteRenderer.
import Lesson from '../../layouts/LessonLayout.astro';
import { renderWalkthrough, renderAskBanner } from '../../lib/walkthrough';
import { renderDecompose } from '../../lib/decompose';

const DECOMPOSE = {
  big: 'Make both player attacks — your sword swing (E) and your fireball (Space) — damage your boss prototype reliably.',
  parts: [
    {
      name: 'Check both melee (KeyCode.E) and ranged (PlayerProjectile) against the boss',
      does: 'Melee checks `currentEnemy` populated by `OnTriggerEnter2D()` for `"Enemy"`, while ranged fires `PlayerProjectile` tagged to collide with `"Enemy"` triggers and call `ChangeHealth()`.',
      doc: '4.6 (melee `attackBox` + `currentEnemy`) & 3.5 (`PlayerProjectile`)',
      href: '3.5.html',
    },
    {
      name: 'Support BossController alongside EnemyController cleanly',
      blank: true,
      doc: 'the `KeyCode.E` and `PlayerProjectile` damage call in the walkthrough below (`ChangeHealth(-1)`)',
    },
  ],
  why:
    'If your boss still uses `EnemyController.cs`, `KeyCode.E` and `PlayerProjectile` already hurt it out of the box! If you created a separate `BossController.cs` (so you can customize phase logic), your player attack code needs to check whether the target carries `EnemyController` OR `BossController` so swings never throw a `NullReferenceException`.',
  turns: [
    'Look at `PlayerController.cs` line 114: `currentEnemy.GetComponent<EnemyController>().ChangeHealth(-1);`. What error occurs if you put a brand-new `BossController` on your boss without updating that lookup?',
    'Look at `PlayerController.cs` lines 73-93 (`attackBox.transform.position = ...`): why does placing the boss hitbox offset along `xDirection`/`yDirection` matter when standing right next to a large boss sprite?',
  ],
};

const WALK = {
  ask: 'how do I wire my sword swing and fireball attacks onto the boss?',
  file: 'Assets/Scripts/PlayerController.cs',
  label: 'In the Code',
  level: 2 as const,
  intro:
    'Check your melee branch inside `PlayerController.cs` (`KeyCode.E`) and your projectile trigger inside `PlayerProjectile.cs`. Fill in the safe `BossController` fallback so hits never throw a null reference, whether your boss uses `EnemyController` or `BossController`.',
  steps: [
    {
      title: 'Keep directional attackBox placement and cooldown',
      lead: 'In `PlayerController.Update()`, `xDirection` and `yDirection` position `attackBox` relative to `transform.position` and set `facing`. Both melee (`KeyCode.E`) and shooting (`KeyCode.Space`) share `cooldownTimer`.',
      lines: [
        {
          code: '        cooldownTimer -= Time.deltaTime;',
          what: 'Counts down your 0.5-second shared attack cooldown every frame.',
        },
        { code: '', what: '' },
        {
          code: '        if (Input.GetKeyDown(KeyCode.E) && cooldownTimer < 0 && currentEnemy != null)',
          what: 'Runs only on the frame `E` is pressed, when cooldown has expired, and `OnTriggerEnter2D()` has captured a target in `currentEnemy`.',
        },
        { code: '        {', what: '' },
        {
          code: '            EnemyController enemy = currentEnemy.GetComponent<EnemyController>();',
          what: 'Tries to fetch `EnemyController` first (returns `null` without crashing if this target uses `BossController`).',
        },
        {
          code: '            if (enemy != null) { enemy.ChangeHealth(-1); }',
          what: 'Hurts normal enemies (or bosses built directly on `EnemyController`) by `1`.',
        },
        {
          code: '            else { ____.GetComponent<____>()?.ChangeHealth(____); }',
          what: 'If the target in `currentEnemy` does NOT carry `EnemyController`, look up `BossController` safely and deal `1` point of damage.',
          blank: true,
          hint: 'Reach for `GetComponent<T>()`, `BossController`, and the hurt sign from `EnemyController.ChangeHealth()`.',
          why: '**Safe lookups turn crashes into clean dispatch.** Earlier `currentEnemy.GetComponent<EnemyController>().ChangeHealth(-1)` assumed every `"Enemy"` carried `EnemyController`. Checking `!= null` handles both ordinary grunts and custom bosses.',
        },
        {
          code: '            cooldownTimer = .5f;',
          what: 'Resets the half-second attack cooldown.',
        },
        { code: '        }', what: '' },
      ],
    },
    {
      title: 'Check Boss hurt visual feedback inside ChangeHealth()',
      lead: 'Add a quick white/red hit flash on the boss `SpriteRenderer` inside `ChangeHealth(int amount)` so every melee swing or fireball gives unmistakable instant feedback during prototyping.',
      lines: [
        {
          code: '    public void ChangeHealth(int amount)',
          what: 'Reuses the exact method signature from `EnemyController` (`int amount` where `-1` hurts).',
        },
        { code: '    {', what: '' },
        {
          code: '        health += amount;',
          what: 'Updates current boss HP.',
        },
        {
          code: '        print("Boss HP: " + health);',
          what: 'Temporary prototype log so you can verify damage numbers in Console even before adding a boss UI bar.',
        },
        {
          code: '        if (health <= 0)',
          what: 'Triggers defeat once HP reaches zero.',
        },
        { code: '        {', what: '' },
        {
          code: '            Die();',
          what: 'Spawns the drop/reward and ends the fight.',
        },
        { code: '        }', what: '' },
        { code: '    }', what: '' },
      ],
    },
  ],
  finalFile: `// Inside PlayerController.Update() — supporting both EnemyController & BossController:
        cooldownTimer -= Time.deltaTime;

        if (Input.GetKeyDown(KeyCode.E) && cooldownTimer < 0 && currentEnemy != null)
        {
            EnemyController enemy = currentEnemy.GetComponent<EnemyController>();
            if (enemy != null)
            {
                enemy.ChangeHealth(-1);
            }
            else
            {
                BossController boss = currentEnemy.GetComponent<BossController>();
                if (boss != null)
                {
                    boss.ChangeHealth(-1);
                }
            }
            cooldownTimer = .5f;
        }`,
  finalNote:
    'Do the exact same two-component check inside `PlayerProjectile.cs` (`OnTriggerEnter2D()`) so both `Space` fireballs and `E` swings damage your boss identically!',
};

const body = `
${renderAskBanner('how do I wire my sword swing and fireball attacks onto the boss?', 2)}

<p class="lead">
    Your player already fights in two ways: close-up melee with <code>KeyCode.E</code>
    (<code>attackBox</code> + <code>currentEnemy</code>) and ranged shots with
    <code>KeyCode.Space</code> (<code>PlayerProjectile</code>). Today you make sure both cleanly
    register hits on your boss prototype and produce unmistakable visual feedback.
</p>

<!-- ============================================================ -->
${renderDecompose('8.3', DECOMPOSE, 2)}

<!-- ============================================================ -->
<div class="activity basic-app">
    <div class="activity-header">
        <span class="activity-label">In the Editor</span>
        <span class="activity-time">~20 min</span>
    </div>

    <ol>
        <li>Select your <code>Boss</code> prefab/object in the Hierarchy: make sure it has a 2D collider marked <strong>Is Trigger</strong> tagged <code>Enemy</code> large enough for <code>attackBox</code> (on <code>Player</code>) and <code>PlayerProjectile</code> to reach cleanly.</li>
        <li>Inspect <code>PlayerController</code>'s Inspector on your <code>Player</code> prefab: confirm <code>Attack Box</code> and <code>Projectile</code> are both assigned and not <code>None</code>.</li>
        <li>Test standing left, right, and below the boss while pressing <code>E</code> and <code>Space</code>: confirm <code>facing</code> aims your projectile correctly even in platformer scenes (remember in <code>Platformer</code>, pressing <code>J</code> does not set <code>facing</code> — only horizontal/vertical axis movement updates <code>facing</code>!).</li>
    </ol>

    <div class="callout trap">
        <strong>Why did my melee swing miss an enlarged boss?</strong> Check how <code>attackBox</code>
        detects targets on your <code>Player</code>! In <code>PlayerController</code>,
        <code>OnTriggerEnter2D()</code> only updates <code>currentEnemy</code> the frame a trigger
        <em>enters</em>. If your boss also has a solid collider pushing the player backward before
        <code>attackBox</code> overlaps the boss trigger, enlarge the outer <code>Enemy</code> trigger
        or step back out and back in cleanly.
    </div>

    <div class="socratic">
        <h3>Socratic: Balancing Two Player Verbs</h3>
        <ol>
            <li>In <code>PlayerController.cs</code>, melee (<code>E</code>) and shooting (<code>Space</code>) share the same <code>cooldownTimer = .5f;</code>. How could changing fireball cooldown vs melee damage encourage the player to dash in close instead of camping in a corner?</li>
            <li>If your boss only takes damage on a tiny glowing weak spot collider instead of its whole body, what happens when a careless <code>Space</code> shot hits the armored shell?</li>
            <li>What feedback (Console log, brief white sprite tint, particle burst, audio pop) proves in a quarter-second playtest that a shot actually hurt the boss rather than getting absorbed?</li>
        </ol>
    </div>
</div>

<!-- ============================================================ -->
${renderWalkthrough(WALK)}

<!-- ============================================================ -->
<div class="checklist">
    <h3>Checkpoint — before moving on, you must be able to:</h3>
    <ul>
        <li>Damage your boss reliably with both <code>KeyCode.E</code> melee and <code>KeyCode.Space</code> fireballs</li>
        <li>Support <code>BossController</code> alongside <code>EnemyController</code> without null reference errors</li>
        <li>Confirm directional <code>facing</code> and trigger overlaps work from both left and right sides of the boss</li>
        <li>Verify visible hit feedback so every landed attack reads immediately</li>
        <li>Commit and push</li>
    </ul>
</div>

