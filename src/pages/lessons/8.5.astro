import Lesson from '../../layouts/LessonLayout.astro';
import { renderAskBanner } from '../../lib/walkthrough';
import { renderDecompose } from '../../lib/decompose';
import type { DecomposeSpec } from '../../lib/decompose';

// The recurring two-beat block: split the problem, look each part up, connect
// it to something already built. Level 3, so the renderer withholds what each
// part DOES and asks the student to say it - the parts and their doc pointers
// are the level-3 bargain. Every doc pointer is a lesson the student has
// finished (2.2, 5.2, 5.3, 7.5, 8.2) and nothing later than today: the
// "connect it" beat is checked for forward references by verify-site.mjs, so
// no part of it names a lesson that has not happened yet.
const DECOMPOSE: DecomposeSpec = {
  big: 'The boss can be beaten and the player can die, and neither ending is real yet: a health value reaches zero, an object disappears, and nothing a player would call a win or a loss ever happens. The fight has two exits and today both of them are walls.',
  parts: [
    {
      name: 'Build the thing the win happens to',
      does: 'The exit does not exist anywhere in this project - the fight was never finished, so there is no door, no gate and no arena exit to open. You build the object first, in the arena, and only then give it a reason to change.',
      doc: '5.2 - The Door: Opening It with Events (the object that changes, and the listener you wire in the Inspector); the machine itself is `Assets/Prefabs/Switch.prefab`',
      href: '5.2.html',
    },
    {
      name: 'Fire the win from the boss\'s death, not from a keypress',
      does: 'The lever fires because a human pressed a key; the boss would fire because a number reached zero. The cause is different and the effect is identical - which is exactly why the effect is an event rather than a direct call.',
      doc: '8.2 - Boss Body, Health & Phases (the boss\'s health, and what already runs on the frame it reaches zero)',
      href: '8.2.html',
    },
    {
      name: 'Put the health reset where nothing can skip it',
      does: 'Health now lives in a singleton that survives a scene load, so a respawn that does not re-arm it spawns the player on zero and kills them again on the first frame that checks. It is one deliberate step, and its placement is the decision.',
      doc: 'the `StatManager` singleton you moved the stats into in 5.3, and the death rule you chose in 2.2 - Spikes: Physics, Damage & Death',
      href: '2.2.html',
    },
    {
      name: 'Decide which scene the respawn lands in, and check what is in it',
      does: 'A scene load is a build index, not a name, and it rebuilds only what is scene-local - so the arena comes back whole and the player\'s numbers do not. The scene you choose also decides whether the player arrives next to the fight or a level away from it.',
      doc: '5.3 - the build-index order, and `Assets/Scripts/Package Scripts/SceneSwitch.cs`, whose `static` fields reposition the player after any load',
      href: '5.3.html',
    },
    {
      name: 'Time the walk back and decide whether the wipe costs too much',
      does: 'From the frame health hits zero to the frame the player is standing in the arena again: that number, off a stopwatch, is what dying costs. It decides whether a boss is a challenge or a chore, and it is fixed like a level rather than like a script.',
      doc: '7.5 - Design a Big Cave: Flow & Difficulty (the same audit, run on your own arena)',
      href: '7.5.html',
    },
  ],
  why: 'Notice the shape: one ending is a cause looking for an effect, and the other is an effect looking for a reset. Four of these five parts are machinery you already own - a UnityEvent with an Inspector listener from 5.2, a death rule from 2.2, a scene load and a singleton from 5.3, an audit from 7.5. What is genuinely new today is that two of those pieces disagree: the singleton keeps health across a load, and the death rule was written back when a load wiped everything. Naming that disagreement is the work; the win itself is a few lines of wiring.',
  sizeTest: 'The split is finished when each part names something you could point at and defend: an object in the Hierarchy, one method on one script, a scene index, a number off a stopwatch. "Make the endings real" points at nothing. "The frame the boss\'s health reaches zero" points at one method in one file, and that is a part.',
  turns: [
    'The lever fires on a keypress and the boss would fire on a health value. Which of the two is the better model for your win - and what would the boss\'s script have to know about your level in order to do it the other way?',
    'Your win happens in a scene and your coins live in a singleton. Name one thing the player should deliberately keep across a win and one thing you should deliberately reset, and say where each of those two decisions is written down today.',
  ],
};

const body = `<h1>8.5 — Win, Lose &amp; the Death Loop</h1>

<p class="lesson-lead">
    Every fight ends one of two ways, and today both have to be real: the boss dies and the game
    acknowledges it, or you die and find out what your death loop costs. Systems from five units
    meet here — and two of them disagree.
</p>

${renderAskBanner('how do I make winning and dying both real?', 3)}

${renderDecompose('8.5', DECOMPOSE, 3)}

<!-- ============================================================ -->
<div class="activity discovery">
    <div class="activity-header">
        <span class="activity-label">The Problem: Winning Has Nowhere to Go</span>
        <span class="activity-time">~10 min</span>
    </div>

    <p>
        Write down what your game does when the boss's health reaches zero. Not what <em>should</em>
        happen — what the code <em>does</em>. For most builds the boss's object disappears and the
        Console prints nothing.
    </p>
    <p>
        The obvious fix is "open the exit", so check whether an exit exists: this project has no
        boss door, no arena gate and no locked exit. What it has is machinery you have used once —
        <code>Assets/Prefabs/Switch.prefab</code> carries a working <code>Lever.cs</code> whose two
        UnityEvents, <code>onLeverOn</code> and <code>onLeverOff</code>, ship <strong>empty on the
        prefab</strong>. Today you point that machinery at a new cause.
    </p>

    <table>
        <tr><th>How the win lands</th><th>What you build</th><th>What it costs, and what it buys</th></tr>
        <tr>
            <td><strong>(a) A lever-style event</strong></td>
            <td>An exit object in the arena, and a UnityEvent fired from the boss's death path instead of from a keypress. The listener does whatever your win means — disable a barrier, play an animation, reveal the way onward.</td>
            <td>An object to build and a listener you configure in the Inspector, where the code cannot see it. In exchange, the boss has no idea what a door is.</td>
        </tr>
        <tr>
            <td><strong>(b) Load a scene directly</strong></td>
            <td>The death path calls a scene load — the same idea as the <code>SceneSwitch</code> script that has moved you between scenes since <a href="5.3.html">5.3</a>.</td>
            <td>A hard cut with no ceremony, and it skips anything you wanted to show the player. Check which scene you are loading <em>into</em> before you write it.</td>
        </tr>
        <tr>
            <td><strong>(c) Nothing but a statement</strong></td>
            <td>A single line printed when the boss dies, and the fight simply stops.</td>
            <td>The player is left in a quiet room, with no confirmation the game noticed. It is also today's fallback: prove the fight can be won before you spend a session on ceremony.</td>
        </tr>
    </table>

    <div class="socratic">
        <h3>Socratic: Two Endings, Two Paths</h3>
        <ol>
<li>Write your win and your loss as two separate sentences. Which of the three approaches above does each need — and do they need to be the same approach?</li>
<li>All three of your scenes contain a Player, so no scene can strand you. But only one contains your HUD. What does the player see if your death loop sends them somewhere else — and does that change which death rule you chose in <a href="2.2.html">2.2</a>?</li>
<li>The lever's UnityEvents are empty on the prefab and already wired on the instance in your Overworld. What does that tell you about where a behaviour lives — and if you drag in a fresh Switch, which of the two do you inherit?</li>
</ol>
    </div>
</div>

<!-- ============================================================ -->
<div class="activity basic-app">
    <div class="activity-header">
        <span class="activity-label">Read Function-Level Examples</span>
        <span class="activity-time">~15 min</span>
    </div>

    <p>
        The end of a fight is a <em>procedure</em>, and procedures have a shape. Five from other
        worlds — ask of each: who decides, who acts?
    </p>

    <p><strong>Example 1 — A fire alarm and the door magnets (the alarm does not know what a door is):</strong></p>
    <pre><code>// The alarm cuts power to the door magnets. It has no idea what a
// door is - it stops holding them open, and physics does the rest.</code></pre>

    <p><strong>Example 2 — The final whistle (the end of the match is one event):</strong></p>
    <pre><code>// The whistle ends the match. Everything after it is a separate
// procedure - the whistle itself does not clear the pitch.</code></pre>

    <p><strong>Example 3 — A dead-man's handle (the safe outcome is the default):</strong></p>
    <pre><code>// If the driver's hand leaves the handle, the brake applies by
// itself. Safety is what happens when nobody does anything.</code></pre>

    <p><strong>Example 4 — Shift-end lockout (restarting is deliberate):</strong></p>
    <pre><code>// The klaxon locks the line out. Starting it again takes a person
// turning a key - it is never a side effect of the klaxon.</code></pre>

    <p><strong>Example 5 — A hotel key card (the room is reset by a deliberate step):</strong></p>
    <pre><code>// The room is re-armed at check-in, not when the guest walks out.
// Nothing resets just because somebody left the building.</code></pre>

    <div class="socratic">
        <h3>Predict Before Building</h3>
        <ol>
<li>Example 1 separates the alarm from the doors. Which of your two endings would benefit from that same separation, and which is fine as a direct call?</li>
<li>Example 3 makes the safe outcome automatic. In your game, what is the automatic outcome when the player's health reaches zero — and who or what makes it happen?</li>
<li>Example 5 is the one that will bite you. Which of your numbers is <em>not</em> reset by leaving a scene, and therefore needs a deliberate re-arming step of its own?</li>
</ol>
    </div>
</div>

<!-- ============================================================ -->
<div class="activity discovery">
    <div class="activity-header">
        <span class="activity-label">In the Editor</span>
        <span class="activity-time">~20 min</span>
    </div>

    <ol>
        <li>
            <strong>Hierarchy →</strong> create the exit object — <strong>right-click → Create
            Empty</strong>, or drag a sprite in from <code>Assets/Artwork</code> — then
            <strong>Scene view →</strong> place it where the player will see it. There is no door
            in the arena, so what you are placing is the door.
        </li>
        <li>
            <strong>Inspector → Add Component →</strong> whatever your exit needs: a <strong>Box
            Collider 2D</strong> with <strong>Is Trigger</strong> ticked if the win is "the player
            arrives somewhere", or a <strong>Sprite Renderer</strong> alone if the exit is a thing
            that appears.
        </li>
        <li>
            <strong>Project window → <code>Assets/Prefabs</code> →</strong> <code>Switch.prefab</code>
            is 5.2's machinery. Drag a fresh instance into the <strong>Scene view</strong> if you
            want its two events, then <strong>Inspector →</strong> the event's list: <strong>+</strong>
            adds a slot, the object field takes the exit, the dropdown takes the method.
        </li>
        <li>
            <strong>Inspector → Game view →</strong> press Play and win the fight any way you can,
            then watch whether your exit changes. A win path you have never seen fire is a theory.
        </li>
        <li>
            <strong>GitHub Desktop →</strong> commit the win path before you touch the death rule.
            One ending is about to make the other harder to debug.
        </li>
    </ol>
</div>

<!-- ============================================================ -->
<div class="activity basic-app">
    <div class="activity-header">
        <span class="activity-label">In the Code</span>
        <span class="activity-time">~25 min</span>
    </div>

    <p>
        Read your own death rule before you change it. In <a href="2.2.html">2.2</a> you chose one of
        three designs, and the choice was simple then: everything about the player lived on
        <code>PlayerController</code> and died with the scene. Then <a href="5.3.html">5.3</a> moved
        your stats into a <code>StatManager</code> singleton that survives a load — and nobody told
        you what that did to this rule.
    </p>

    <table>
        <tr><th>Your <a href="2.2.html">2.2</a> choice</th><th>What it did then</th><th>What it does now that stats are a singleton</th></tr>
        <tr>
            <td><strong>(a) Reload the current scene</strong></td>
            <td>The scene was rebuilt from scratch: the player, the coins and their health all reset. Death was a clean slate.</td>
            <td>The scene is rebuilt, but the health number is <em>not</em> — it lives in the singleton, which survived the load. Follow it through: the player spawns with the health they died on, and the next frame that checks it kills them again, forever.</td>
        </tr>
        <tr>
            <td><strong>(b) Load a scene by name</strong></td>
            <td>Whatever scene you named was loaded, and everything about the player was rebuilt there.</td>
            <td>Same persistence problem, plus the scene-identity problem: check whether the scene you named is the one the fight is in. All three scenes contain a Player, so you cannot be stranded — but load <code>Start</code> (the hub scene) and the arena is a load away.</td>
        </tr>
        <tr>
            <td><strong>(c) No reload at all</strong></td>
            <td>Health was reset by hand and the player was moved back to a start position. Coins were kept on purpose.</td>
            <td>The only one of the three that already does the right thing, because you were already resetting health explicitly. Check that the reset writes to the singleton, not to a field on the player.</td>
        </tr>
    </table>

    <div class="callout info">
        <strong>The boss does not have this problem, and that is the point.</strong> The boss's
        health is scene-local — the decision you made in <a href="8.2.html">8.2</a> — so the arena
        reload brings it back at full health. That is the arcade rule: a wipe resets the test. Keep
        it or change it, but say which, because it is a decision rather than a side effect.
    </div>

    <div class="callout">
        <strong>Architectural specification: the win path.</strong>
        <ul>
            <li>What exactly does the listener do — disable an object, move a barrier, load a scene, print a line? Write that as one sentence.</li>
            <li>Who can hear the event? If two objects in the arena both listen, what happens — and is that useful or confusing?</li>
            <li>The death path probably also destroys the boss's object. Before or after the event fires — and what breaks if the object is gone when the listener runs?</li>
            <li>Anything the boss spawned and left in flight — attacks, projectiles — outlives the boss unless something stops it. Which pattern from <a href="5.2.html">5.2</a> finds them all at once?</li>
            <li>Is the win state reachable twice? What happens if the death path runs a second time, and what guards it?</li>
        </ul>
    </div>

    <div class="callout">
        <strong>Architectural specification: the loss path.</strong>
        <ul>
            <li>What condition means "the player is dead" now that health lives in the singleton — and where is that condition checked?</li>
            <li>Which scene does the respawn land in, does it contain a Player, and does it contain the arena? Those may be two different scenes, and if so that is a decision.</li>
            <li>What sets health back to maximum, and where does that step live — the death path, the singleton's own start-up, or the player's spawn?</li>
            <li>What happens to the coins under your rule? State it as a rule the player could be told, not as a side effect of where the number lives.</li>
            <li>How many times can the player die in a row before the game becomes unplayable? Test the loop three times.</li>
        </ul>
    </div>

    <div class="socratic">
        <h3>Ascertaining the Loop</h3>
        <ol>
<li>Die on purpose and watch the Console. What is the player's health on the first frame of the new scene, and how do you know?</li>
<li>Which of the three <a href="2.2.html">2.2</a> death designs did you choose, and what does it now fail to reset?</li>
<li>Your death rule loads a scene, and <code>SceneSwitch</code> repositions the player from <code>static</code> fields that your load never updated. Where does the player actually arrive — and is that where you meant?</li>
</ol>
    </div>
</div>

<!-- ============================================================ -->
<div class="activity basic-app">
    <div class="activity-header">
        <span class="activity-label">Playtest &amp; the Death Audit</span>
        <span class="activity-time">~20 min</span>
    </div>

    <p>
        Hand the game to a partner. Watch for one thing per run — write down what you see before you
        say anything.
    </p>

    <ul>
        <li><strong>Run 1 — the ending.</strong> Did they know they had won without being told? Did
            they know they had lost? If either answer is no, your win and loss paths are
            invisible.</li>
        <li><strong>Run 2 — the wipe.</strong> Let them die once and say nothing. Time how long
            before they are back in the fight, and watch their face at the moment of death.</li>
    </ul>

    <p>
        <strong>Then time the walk back yourself.</strong> Stopwatch, from the frame health hits
        zero to the frame they stand in the arena ready for the first exchange. That number is what
        a wipe costs, and it decides whether your boss is a challenge or a chore. Over a minute?
        Pick one fix and defend it:
    </p>
    <ul>
        <li><strong>A shortcut</strong> — a route that only exists after the player has already
            reached the arena once.</li>
        <li><strong>A checkpoint</strong> — a trigger near the arena that becomes the respawn
            point, so your death rule needs a respawn position, not a whole scene.</li>
        <li><strong>Shorter approach</strong> — cut the level between the last checkpoint and the
            arena. The <a href="7.5.html">7.5</a> audit, applied to your own cave.</li>
    </ul>
</div>

<!-- ============================================================ -->

<div class="checklist">
    <h3>Checkpoint — before moving on, you must be able to:</h3>
    <ul>
        <li>Explain what your win path does, and name the object you had to build for it</li>
        <li>Explain why the boss comes back at full health after a wipe, and whether that is design or accident</li>
        <li>Explain what your death rule does <em>now</em>, and where the health reset lives</li>
        <li>Explain what <code>SceneSwitch</code>'s <code>static</code> variables do when your own code loads a scene</li>
        <li>Quote your death-audit time from a stopwatch, and defend the fix you chose</li>
        <li>Commit and push</li>
    </ul>
</div>

<!-- ============================================================ -->
<div class="resources">
    <h3>Reference Docs</h3>
    <p>Need a deeper explanation? These pages cover the same concepts:</p>
    <ul>
        <li><a href="../docs/unit-08/index.html">Unit 8: Boss Fight</a> — win and loss design</li>
        <li><a href="../docs/unit-05/index.html">Unit 5: The Axe &amp; The Cave</a> — events, singletons and scene loads, revisited</li>
        <li><a href="../docs/reference/unity-csharp-quickref.html">Unity + C# Quick Reference</a> — <code>UnityEvent</code>, scene loading and object lifetime</li>
    </ul>
    <p>Next: <a href="8.6.html">8.6 — Boss Studio + Final Review</a>, where you play the whole thing from the beginning.</p>
</div>`;
