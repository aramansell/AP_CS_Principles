    {
      title: 'Refill jumpsRemaining on Ground collision',
      lead: 'Add `OnCollisionEnter2D(Collision2D other)` below `OnTriggerExit2D()` so landing on any solid collider tagged `"Ground"` restores `jumpsRemaining`.',
      lines: [
        {
          code: '    void OnCollisionEnter2D(Collision2D other)',
          what: 'Called automatically by Unity Physics 2D when two solid (non-trigger) colliders start touching.',
        },
        { code: '    {', what: '' },
        {
          code: '        if (other.gameObject.CompareTag("Ground"))',
          what: 'Checks the Tag on the GameObject you landed on.',
          why: '**Not every solid object is a floor.** Walls, enemies, and moving barriers can also trigger `OnCollisionEnter2D()`; checking `CompareTag("Ground")` prevents wall-jumping off anything unintended.',
        },
        { code: '        {', what: '' },
        {
          code: '            jumpsRemaining = maxJumps;',
