const body = `<h1>7.3 — Ladders I: The Climbing State</h1>

<p class="lesson-lead">
    Go and look for a ladder. Search the project for a sprite, a tile, a prefab, an animation
    clip — search the word itself. The word finds nothing, and that is the trap: there is no
