// Lesson 5.3 — Into the Cave: Persistence & the HUD
// The architectural payoff lesson. The student walks into a cave, discovers what
// a scene load actually does, and then puts the numbers on screen for the first
// time.
//
// WHAT CHANGED AND WHY (alignment pass, 2026-11-05): the StatManager singleton
// used to be BUILT here — as `Instance`, with `TakeDamage(int)` (positive hurts),
// `Mathf.Clamp`, `GetCoins()`/`GetHealth()` accessors and an axe flag, and with
// the refactor of PlayerController as the lesson's centre. The project did that
// refactor on 2.7 instead, and the file it produced is different in every one of
// those details:
//
//     public int health = 3;  public int maxHealth = 3;  public int coins;
//     public static StatManager original;
//     Awake(): if (original != null && original != this) { Destroy(gameObject); }
//              else { original = this; DontDestroyOnLoad(gameObject); }
//     ChangeHealth(int amount)  // signed: negative hurts, clamps at maxHealth, Die() at <= 0
//     ChangeCoins(int amount)   // signed, floors at 0
//     Die()                     // health = maxHealth; coins = coins / 2
//
