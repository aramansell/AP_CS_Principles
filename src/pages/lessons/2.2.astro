const WALK = {
  ask: 'how do I stop my character walking through walls?',
  file: 'Assets/Scripts/PlayerController.cs',
  intro: 'The shape of your file stays exactly as it is — fields at class scope, input read in Update(). Only the lines that change what moves the character are left for you to write.',
  level: 2,
  steps: [
    {
      title: 'Keep a handle on the body',
      lead: 'You gave the Player a Rigidbody2D in 2.1. To hand it instructions you need a reference to it, and you find that once — not sixty times a second.',
      lines: [
        { code: '    [SerializeField] private float moveSpeed = 5f;', what: 'Your existing speed knob. Unchanged.' },
        { code: '', what: '' },
        { code: '    private Rigidbody2D body;', what: 'A field to hold the Player\'s Rigidbody2D component. Class body, not inside a method — the same rule from 1.3: this has to still be here on the next frame.' },
        { code: '', what: '' },
        { code: '    private float inputX;', what: 'Your existing input fields. Still declared here, still assigned in Update(). Nothing about 1.4 changes.' },
        { code: '    private float inputY;', what: '' },
        { code: '', what: '' },
        { code: '    void Start()', what: 'The once-only setup method from 1.3. It has been empty until now — this is what it is for.' },
        { code: '    {', what: '' },
        { code: '        body = GetComponent<Rigidbody2D>();', what: 'Look up the Rigidbody2D sitting on this same GameObject and store it in `body`. `GetComponent<T>()` finds a component on the object the script is attached to.' , why: '**Once, in `Start()` — never in `Update()`.** `GetComponent` is a search, and calling it every frame is 60 searches a second for an answer that never changes. Assigning it in `Start()` is the same "decide once, remember it" instinct as declaring `inputX` at class scope.' },
        { code: '    }', what: '' },
      ],
    },
    {
      title: 'Compute the movement you already know how to compute',
      lead: 'None of this is new — it is the vector from 1.4, rebuilt so it points somewhere rather than describing a distance.',
      lines: [
        { code: '    void Update()', what: 'Still the every-frame method. `Start()` ran once; `Update()` runs from now until you stop playing.' },
        { code: '    {', what: '' },
        { code: '        inputX = Input.GetAxis("Horizontal");', what: 'Assign, not declare. Same two lines, same reasoning, as 1.4.' },
        { code: '        inputY = Input.GetAxis("Vertical");', what: '' },
        { code: '', what: '' },
        { code: '        Vector2 direction = new Vector2(inputX, inputY);', what: 'The two axis values, packed into one vector. This is a **direction** now, not a distance — it says which way, not how far.' },
        { code: '', what: '' },
        { code: '        body.linearVelocity = direction * moveSpeed;', blank: true, what: 'Hand the body a velocity instead of moving the Transform yourself. This one line replaces `transform.Translate(movement);`, and it is the whole fix.', hint: 'You want the property on `body` that says how fast it is travelling, set to `direction` multiplied by `moveSpeed`. In Unity 6 that property is no longer called `velocity`.', why: 'Two things changed at once, and both matter. First, **you are asking the physics engine to do the moving** — so it knows where you are going and can stop you. Second, **there is no `Time.deltaTime`.** Velocity is already measured *per second*, so the engine applies the time for you. Multiplying by `deltaTime` here is the most common mistake on this line.' },
      ],
    },
    {
      title: 'Finish the step and prove it',
      lead: 'Close the method, then make the settings in the Inspector match what you just wrote.',
      lines: [
        { code: '    }', what: 'Closes `Update()`. One more `}` closes the class.' },
        { code: '', what: '' },
        { code: '// Inspector, on Assets/Prefabs/Player ▸ Rigidbody 2D:', what: '' },
        { code: '//   Body Type          =  Dynamic', what: '**Must be Dynamic.** This is the setting the whole lesson turns on — only a Dynamic body is stopped by the world. Still what you set in 2.1: leave it.' , why: 'If you are tempted to switch this to **Kinematic** because the `MovePosition` documentation tells you to, read the next activity before you do. A Kinematic body "only collides with Dynamic Rigidbody 2Ds and not the other Body Types" — so it walks straight through your walls and through your cave doors.' },
        { code: '//   Gravity Scale      =  0', what: 'Already 0 from 2.1. Top-down worlds have no down.' },
        { code: '//   Freeze Rotation Z  ☑ ON', blank: true, what: 'Stop the body from spinning: find the **Constraints** section of the Rigidbody 2D and freeze rotation on the **Z** axis. This is an Inspector setting, so record it as a comment in your file.', hint: 'In 2.1 you left Constraints alone, because nothing in the world was solid to you.', why: 'This did not matter in 2.1 — a trigger reports an overlap without pushing anything, so nothing could ever spin you. A **solid** collider does push, and an off-centre hit imparts torque. Without this, your character tumbles like a dropped coin the first time it hits a wall at an angle.' },
        { code: '//   Interpolate        =  Interpolate', what: 'Already set in 2.1. Keeps movement smooth between physics steps.' },
      ],
    },
  ],
  finalFile: `using UnityEngine;

public class PlayerController : MonoBehaviour
{
    [SerializeField] private float moveSpeed = 5f;
    [SerializeField] private int health = 3;
    [SerializeField] private int coins;

    private Rigidbody2D body;

    private float inputX;
    private float inputY;

    void Start()
    {
        // Look the component up ONCE. Never inside Update().
        body = GetComponent<Rigidbody2D>();
    }

    void Update()
    {
        inputX = Input.GetAxis("Horizontal");
        inputY = Input.GetAxis("Vertical");

        Vector2 direction = new Vector2(inputX, inputY);

        // No Time.deltaTime: velocity is per second, not per frame.
        body.linearVelocity = direction * moveSpeed;
    }

    private void OnCollisionEnter2D(Collision2D collision)
    {
        // Collision2D, not Collider2D — so the tag is asked of .gameObject.
        if (collision.gameObject.CompareTag("Spikes"))
        {
            TakeDamage(1);
        }
    }

    private void OnTriggerEnter2D(Collider2D other)
    {
        if (other.CompareTag("Coin"))
        {
            coins = coins + 1;
            Debug.Log("Coins collected: " + coins);
            Destroy(other.gameObject);
        }
    }

    private void TakeDamage(int amount)
    {
        if (health <= 0)
        {
            return;
        }

        health = health - amount;
        Debug.Log("Health: " + health);

        if (health <= 0)
        {
            Debug.Log("Player died.");
        }
    }
}

// Inspector, on Assets/Prefabs/Player ▸ Rigidbody 2D:
//   Body Type          =  Dynamic     <- only Dynamic is stopped by the world
//   Gravity Scale      =  0           <- top-down world, no down
//   Freeze Rotation Z  =  ON          <- solid hits impart spin
//   Interpolate        =  Interpolate`,
  finalNote:
    'Compare against your own file rather than copying it. The two gaps are `body.linearVelocity = direction * moveSpeed;` and the frozen Z rotation, and neither of them is right by luck: the first has no `deltaTime` because velocity is per second, the second exists because solid collisions push.',
};

