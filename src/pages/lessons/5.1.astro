};

const body = `<h1>5.1 — The Axe: Item Pickups &amp; Inventory Bools</h1>

<p class="lesson-lead">
    Coins and potions changed <em>numbers</em>. The axe changes what you <em>are</em>: it flips a
    boolean — that half you have written three times already — and then it replaces the entire
    machine that draws your character. That second half is one line long, and nothing you have
    built so far prepares you for it.
</p>

${renderAskBanner('how do I add an item to my inventory?', 2)}

${renderDecompose('5.1', DECOMPOSE, 2)}

