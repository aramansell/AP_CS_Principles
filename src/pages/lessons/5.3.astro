// Lesson 5.3 — Into the Cave: Persistence & the HUD
// Level 1 (Full Walkthrough): StatManager already carries DontDestroyOnLoad and
// the `original` duplicate guard. Today we wire coinText + healthText directly
// inside StatManager.cs, reload the active scene in Die(), and build the Canvas HUD.
import Lesson from '../../layouts/LessonLayout.astro';
import { renderWalkthrough, renderAskBanner } from '../../lib/walkthrough';
import { renderDecompose } from '../../lib/decompose';

const DECOMPOSE = {
  big: 'Keep my health and coins alive when I leave the Overworld — and show them on screen.',
  parts: [
    {
      name: 'Keep one StatManager alive across scene loads',
      does: 'A `public static StatManager original` guard in `Awake()` destroys duplicates when a new scene loads and calls `DontDestroyOnLoad(gameObject)` on the first one.',
      doc: '2.7 (where `StatManager` became a singleton) and `DontDestroyOnLoad` in the quick reference',
      href: '../docs/reference/unity-csharp-quickref.html',
    },
    {
      name: 'Wire the TextMeshProUGUI labels inside StatManager',
      does: 'Two `[SerializeField] TextMeshProUGUI` fields (`coinText` and `healthText`) updated in `Start()`, `ChangeHealth()`, and `ChangeCoins()` — no separate HUD script needed.',
      doc: 'Unity `TextMeshProUGUI.text` row in the reference table below',
    },
    {
      name: 'Reset stats and reload the scene in Die()',
      does: 'Inside `Die()`, restore `health = maxHealth`, halve `coins = coins / 2`, refresh `healthText.text`, and call `SceneManager.LoadScene(current.name)` using `GetActiveScene()`.',
      doc: '`SceneManager` section in the reference table below',
    },
  ],
  why:
    'In `2.7` you moved `health`, `maxHealth`, and `coins` onto `StatManager` because `PlayerController` resets every time a scene loads. Putting `coinText` and `healthText` on that same surviving manager — and letting `Die()` call `SceneManager.LoadScene()` — means both numbers stay glued to the screen through every transition.',
  turns: [
    'Before writing a line, look at `StatManager.Awake()`: what two things happen if `original != null && original != this` when you walk into a scene that already has a `StatManager` in it?',
    'In `StatManager.Die()`, why does `SceneManager.LoadScene(current.name)` NOT reset `coins` back to 0 even though the scene reloads?',
  ],
};

const WALK = {
  ask: 'how do I keep my health and HUD alive across scene switches?',
  file: 'Assets/Scripts/StatManager.cs',
  label: 'In the Code',
  level: 1 as const,
  intro:
    'Open `Assets/Scripts/StatManager.cs`. Your `original` singleton guard and `DontDestroyOnLoad(gameObject)` are already in `Awake()`. Here is the HUD and death-reload code that completes it.',
  steps: [
    {
      title: 'Import TextMeshPro and SceneManagement, and declare the UI slots',
      lead: 'Two `using` directives at the top of `StatManager.cs` and two serialized `TextMeshProUGUI` fields in the class body so Inspector UI objects can be dragged straight onto the manager.',
      lines: [
        {
          code: 'using TMPro;',
          what: 'Brings `TextMeshProUGUI` into scope so C# knows what type `coinText` and `healthText` are.',
        },
        {
          code: 'using UnityEngine.SceneManagement;',
          what: 'Brings `Scene` and `SceneManager` into scope for `Die()`.',
        },
        { code: '', what: '' },
        {
          code: '    [SerializeField] TextMeshProUGUI coinText;',
          what: 'Inspector slot pointing at the `Coins` TMP text object on your Canvas.',
          why: '**Storing text references on `StatManager` avoids a second script.** The manager already runs whenever `ChangeCoins()` or `ChangeHealth()` is called, so updating the label right there guarantees the screen can never drift out of sync with the variable.',
        },
        {
          code: '    [SerializeField] TextMeshProUGUI healthText;',
          what: 'Inspector slot pointing at the `Health` TMP text object on your Canvas.',
        },
      ],
    },
    {
      title: 'Initialize the labels in Start() and update them when values change',
      lead: 'Write the starting labels once in `Start()`, then refresh them inside `ChangeHealth(int amount)` and `ChangeCoins(int amount)` right after clamping.',
      lines: [
        {
          code: '    void Start()',
          what: 'Runs once after `Awake()` finishes on the surviving `StatManager`.',
        },
        { code: '    {', what: '' },
        {
          code: '        health = maxHealth;',
          what: 'Starts the player at full health (`3` by default).',
        },
        {
          code: '        coinText.text = "Coins: " +coins;',
          what: 'Sets the initial coin readout so it does not stay as placeholder text (`"New Text"`).',
        },
        {
          code: '        healthText.text = "Health: " +health;',
          what: 'Sets the initial health readout on frame 1.',
        },
        { code: '    }', what: '' },
        { code: '', what: '' },
        {
          code: '        healthText.text = "Health: " +health;',
          what: 'Add this line at the bottom of `ChangeHealth(int amount)` (right before `if (health <= 0)`), and add `coinText.text = "Coins: " +coins;` inside `ChangeCoins(int amount)`.',
        },
      ],
    },
    {
      title: 'Reset stats and reload the current scene in Die()',
      lead: 'When `health <= 0`, `ChangeHealth()` calls `Die()`. Reset `health`, halve `coins`, update the text, and reload whichever scene the player died in.',
      lines: [
        {
          code: '    public void Die()',
          what: 'Called whenever `health <= 0`. Must be `public` or callable from `ChangeHealth()`.',
        },
        { code: '    {', what: '' },
        {
          code: '        health = maxHealth;',
          what: 'Refills `health` to `3` so the next life does not immediately die again.',
        },
        {
          code: '        healthText.text = "Health: " +health;',
          what: 'Updates the HUD immediately after restoring `health`.',
        },
        {
          code: '        coins = coins / 2;',
          what: 'Integer division penalty: lose half your coins on death.',
          why: '**Integer division drops fractions automatically.** `5 / 2` becomes `2` without any rounding call — a useful reminder when numbers are `int`.',
        },
        {
          code: '        Scene current = SceneManager.GetActiveScene();',
          what: 'Asks Unity which scene is currently open (works for both `"Overworld"` and `"Platformer"`).',
        },
        {
          code: '        SceneManager.LoadScene(current.name);',
          what: 'Reloads the active scene by name, respawning enemies, coins, and the player at the start point.',
        },
        { code: '    }', what: '' },
      ],
    },
  ],
  finalFile: `using UnityEngine;
using TMPro;
using UnityEngine.SceneManagement;

public class StatManager : MonoBehaviour
{
    int health;
    int maxHealth = 3;
    int coins;

    [SerializeField] TextMeshProUGUI coinText;
    [SerializeField] TextMeshProUGUI healthText;

    public static StatManager original;

    void Awake()
    {
        if (original != null && original != this)
        {
            Destroy(gameObject);
            return;
        }

        original = this;
        DontDestroyOnLoad(gameObject);
    }

    void Start()
    {
        health = maxHealth;
        coinText.text = "Coins: " +coins;
        healthText.text = "Health: " +health;
    }

    public void ChangeHealth(int amount)
    {
        health = health + amount;
        if (health > maxHealth)
        {
            health = maxHealth;
        }

        healthText.text = "Health: " +health;

        if (health <= 0)
        {
            Die();
        }
    }

    public void ChangeCoins(int amount)
    {
        coins = coins + amount;
        if (coins < 0)
        {
            coins = 0;
        }

        coinText.text = "Coins: " +coins;
    }

    public void Die()
    {
        health = maxHealth;
        healthText.text = "Health: " +health;
        coins = coins / 2;
        Scene current = SceneManager.GetActiveScene();
        SceneManager.LoadScene(current.name);
    }
}`,
  finalNote:
    'Notice what is NOT in `StatManager.cs`: a second `HudController` script. Because `StatManager` itself owns both `health`/`coins` and `healthText`/`coinText`, parenting your Canvas under `StatManager` lets one `DontDestroyOnLoad` object carry both data and HUD across every scene.',
};

const body = `
${renderAskBanner('how do I keep my health and HUD alive across scene switches?', 1)}

<p class="lead">
    Yesterday your player stayed in one scene. Today you wire the Canvas HUD onto
    <code>StatManager</code>, parent that Canvas so it survives alongside
    <code>DontDestroyOnLoad()</code>, and reload the current scene cleanly inside <code>Die()</code>.
</p>

<!-- ============================================================ -->
${renderDecompose('5.3', DECOMPOSE, 1)}

<!-- ============================================================ -->
<div class="activity basic-app">
    <div class="activity-header">
        <span class="activity-label">In the Editor</span>
        <span class="activity-time">~15 min</span>
    </div>

    <p>
        Create the HUD once and child it under the <code>StatManager</code> GameObject so
        <code>DontDestroyOnLoad(gameObject)</code> carries the UI from <code>Start (index 0)</code>
        into <code>Overworld</code> and <code>Platformer</code> without duplicating it:
    </p>

    <ol>
        <li>Open your starting scene (<code>Start (index 0)</code> or <code>Overworld</code> — whichever loads first in Build Profiles). Right-click the <code>StatManager</code> object in the Hierarchy and create a UI <strong>Canvas</strong> child (<code>UI → Text - TextMeshPro</code> creates both the Canvas and the first text object automatically; accept the TMP Essentials import if prompted).</li>
        <li>Rename the two TextMeshProUGUI children to <code>HealthText</code> and <code>CoinText</code>, anchor them to the top-left corner of the Canvas, and position them clearly above gameplay.</li>
        <li>Select <code>StatManager</code> in the Hierarchy and drag <code>CoinText</code> into the <code>Coin Text</code> slot and <code>HealthText</code> into the <code>Health Text</code> slot in the Inspector.</li>
        <li>Open <code>File → Build Profiles</code> (Build Settings) and verify all three scenes — <code>Start (index 0)</code>, <code>Overworld</code>, and <code>Platformer</code> — are listed in the Scene List.</li>
        <li>Press <strong>Play</strong>, collect a coin, walk through a scene switch, and take damage until <code>Die()</code> fires. Confirm that both numbers survive the scene switch and reset cleanly on death.</li>
    </ol>

    <div class="callout">
        <strong>Why child the Canvas under StatManager?</strong> When <code>StatManager.Awake()</code> calls
        <code>DontDestroyOnLoad(gameObject)</code>, Unity preserves the GameObject <em>and every child attached to it</em>.
        And if a later scene happens to hold its own spare copy of <code>StatManager</code>, the
        <code>if (original != null &amp;&amp; original != this) Destroy(gameObject);</code> guard destroys the duplicate
        along with its extra Canvas so two HUDs never overlap.
    </div>

    <div class="socratic">
        <h3>Socratic: Singletons &amp; Scene Persistence</h3>
        <ol>
            <li>If <code>Overworld</code> also had a <code>StatManager</code> in its Hierarchy, why must <code>Destroy(gameObject)</code> happen inside <code>Awake()</code> instead of waiting for <code>Start()</code>?</li>
            <li>Why does <code>Die()</code> refresh <code>healthText.text</code>, while <code>coinText.text</code> only changes on the next pickup unless you update it inside <code>Die()</code> too?</li>
            <li>What happens in <code>PlayerController.Start()</code> if you run <code>Platformer</code> directly from the Editor without passing through <code>Start (index 0)</code> — does <code>FindAnyObjectByType&lt;StatManager&gt;()</code> find a manager if none was placed in that scene?</li>
        </ol>
    </div>
</div>

<!-- ============================================================ -->
${renderWalkthrough(WALK)}

<!-- ============================================================ -->
<div class="activity basic-app">
    <div class="activity-header">
        <span class="activity-label">Quick Reference: Persistence &amp; Scene API</span>
        <span class="activity-time">Read</span>
    </div>

    <table>
        <tr><th>Member</th><th>What it does</th><th>Gotcha</th></tr>
        <tr>
            <td><code>public static StatManager original;</code></td>
            <td>Shared class-level slot holding the one surviving manager instance.</td>
            <td>Check <code>if (original != null &amp;&amp; original != this)</code> before calling <code>DontDestroyOnLoad()</code>.</td>
        </tr>
        <tr>
            <td><code>DontDestroyOnLoad(gameObject);</code></td>
            <td>Keeps this GameObject (and child Canvas HUD) alive when loading a new scene.</td>
            <td>Only works reliably on root GameObjects — do not nest <code>StatManager</code> under another object.</td>
        </tr>
        <tr>
            <td><code>TextMeshProUGUI.text</code></td>
            <td>Sets the visible string on screen (e.g. <code>"Coins: " +coins</code>).</td>
            <td>Requires <code>using TMPro;</code> and assigning the Inspector field before pressing Play.</td>
        </tr>
        <tr>
            <td><code>SceneManager.GetActiveScene()</code></td>
            <td>Returns the current <code>Scene</code> struct so <code>current.name</code> gives the scene name.</td>
            <td>Requires <code>using UnityEngine.SceneManagement;</code> and scenes added in Build Profiles.</td>
        </tr>
        <tr>
            <td><code>SceneManager.LoadScene(current.name)</code></td>
            <td>Reloads the current scene from scratch on death.</td>
            <td>Scene-local pickups and enemies reset; <code>StatManager</code> fields do not unless you reset them in <code>Die()</code>.</td>
        </tr>
    </table>
</div>

