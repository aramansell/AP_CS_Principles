// Three code blocks, each opening with a comment saying where in EnemyController
// .cs it goes: the fields with the fields, the memory and its seed in the class
// body and Start(), the loop in Update(). One gap, on the turn.
const WALK = {
  ask: 'how do I make an enemy follow a patrol route?',
  file: 'Assets/Scripts/EnemyController.cs',
  label: 'In the Code',
  intro: 'The enemy ships as a stub: an empty EnemyController on a prefab you just gave a body to, standing in the Overworld four times over. Today it gets two ends to its beat and one field that remembers which end it is walking toward. The movement line is the one you chose in 2.2 — if you move your Player a different way, keep your method and read the shape.',
  level: 2,
  steps: [
    {
      title: 'Declare the two ends of the beat and the numbers that tune it',
      lead: 'Four lines in the class body, and every one of them is a line a designer can see in the Inspector — the `[SerializeField]` pattern from 1.3.',
      lines: [
        { code: '// EnemyController.cs — class body, above Start(), with your other fields.', what: '' },
        { code: '    [SerializeField] private Transform waypointA;', what: 'One end of the beat. A `Transform` holds a position in the world — and, wired from the Inspector, it holds a *reference to another object*, which is what a waypoint slot is.' , why: '**Slots, not typed-in coordinates.** A waypoint is a place in the scene, so it belongs to the scene: you can drag either end while the game is running and watch the beat move. Two hard-coded x values would give the same straight line and break the moment you moved the prefab somewhere else.' },
        { code: '    [SerializeField] private Transform waypointB;', what: 'The other end. Two slots rather than one, because a beat has two ends and the enemy has to be able to reach both.' },
        { code: '    [SerializeField] private float moveSpeed = 2f;', what: 'How fast it walks, in units **per second** — the same kind of knob, with the same name, as `moveSpeed` on your Player.' },
        { code: '    [SerializeField] private float arriveDistance = 0.1f;', what: 'How close counts as **arrived** — the number that decides when the beat turns around.' , why: 'It has to be small enough that the enemy looks like it reached the waypoint, and large enough that it can actually *reach* it. An enemy that travels further in one frame than this number walks straight past the waypoint and never arrives at all.' },
        { code: '', what: '' },
        { code: '    private Rigidbody2D body;', what: 'A place to keep the reference to the enemy\'s own body, so the movement line in step 3 does not have to search for it every frame. You keep one of these on the Player for exactly the same reason.' },
      ],
    },
