  finalFile: `using System;
using UnityEngine;

// Your controller at the end of 5.1: movement from 1.4, animation from 1.6,
// the pickups from 2.1-2.3, melee and the player projectile from 3.5 and 4.6,
// the stats moved onto the StatManager in 2.7 — and the axe.
public class PlayerController : MonoBehaviour
{
    float xVector;
    float yVector;
    float speed = 4;
    float xDirection;
    float yDirection;

    Animator animator;
    SpriteRenderer renderer;

    float cooldownTimer = .5f;
    Rigidbody2D rb;

    GameObject currentEnemy;
    String facing;

    [SerializeField] GameObject projectile;
    [SerializeField] GameObject attackBox;

    StatManager manager;

    // The capability, and the controller that draws it. The starting value is
    // the design: false, until the player earns it.
    [SerializeField] bool hasAxe = false;
    [SerializeField] RuntimeAnimatorController axeController;

    private void Start()
    {
        // Looked up once, never inside Update() — the rules from 1.6 and 2.2.
        renderer = GetComponentInChildren<SpriteRenderer>();
        animator = GetComponentInChildren<Animator>();
        rb = GetComponent<Rigidbody2D>();
        manager = FindAnyObjectByType<StatManager>();
    }

    private void Update()
    {
        xDirection = Input.GetAxisRaw("Horizontal");
        yDirection = Input.GetAxisRaw("Vertical");
        xVector = xDirection * speed;
        yVector = yDirection * speed;

        // Facing moves the hitbox that 4.6's melee checks.
        if (xDirection > 0)
        {
            facing = "Right";
            attackBox.transform.position = transform.position + new Vector3(.5f, .5f, 0);
        }
        else if (xDirection < 0)
        {
            facing = "Left";
            attackBox.transform.position = transform.position + new Vector3(-.5f, .5f, 0);
        }

        if (yDirection > 0)
        {
            facing = "Up";
            attackBox.transform.position = transform.position + new Vector3(0, 1, 0);
        }
        if (yDirection < 0)
        {
            facing = "Down";
            attackBox.transform.position = transform.position + new Vector3(0, 0, 0);
        }

        // No Time.deltaTime: velocity is per second, not per frame.
        rb.linearVelocity = new Vector2(xVector, yVector);

        cooldownTimer -= Time.deltaTime;

        if (Input.GetKeyDown(KeyCode.E) && cooldownTimer < 0 && currentEnemy != null)
        {
            currentEnemy.GetComponent<EnemyController>().ChangeHealth(-1);
            cooldownTimer = .5f;
        }

        if (Input.GetKeyDown(KeyCode.Space) && cooldownTimer < 0)
        {
            Shoot();
            cooldownTimer = .5f;
        }

        UpdateAnimation();
    }

    void UpdateAnimation()
    {
        bool isMoving = xVector != 0 || yVector != 0;
        animator.SetBool("IsWalking", isMoving);

        if (Mathf.Abs(xVector) > Mathf.Abs(yVector))
        {
            animator.SetInteger("WalkDir", 1);
            if (xVector < 0)
            {
                renderer.flipX = false;
            }
            else if (xVector > 0)
            {
                renderer.flipX = true;
            }
        }
        else if (yVector > 0)
        {
            animator.SetInteger("WalkDir", 0);
        }
        else if (yVector < 0)
        {
            animator.SetInteger("WalkDir", 2);
        }
    }

    // Every pickup in the game arrives here. The axe is one more question.
    void OnTriggerEnter2D(Collider2D other)
    {
        if (other.gameObject.CompareTag("E_Fireball"))
        {
            manager.ChangeHealth(-2);
            Destroy(other.gameObject);
        }

        if (other.gameObject.CompareTag("Enemy"))
        {
            currentEnemy = other.gameObject;
        }

        if (other.gameObject.CompareTag("Coin"))
        {
            manager.ChangeCoins(1);
            Destroy(other.gameObject);
        }

        if (other.gameObject.CompareTag("Potion"))
        {
            manager.ChangeHealth(1);
            Destroy(other.gameObject);
        }

        // New in 5.1: the axe.
        if (other.gameObject.CompareTag("Axe"))
        {
            hasAxe = true;
            animator.runtimeAnimatorController = axeController;
            Destroy(other.gameObject);
        }
    }

    void OnTriggerExit2D(Collider2D other)
    {
        if (other.gameObject.CompareTag("Enemy"))
        {
            currentEnemy = null;
        }
    }

    void Shoot()
    {
        GameObject copy = Instantiate(projectile, transform.position, Quaternion.identity);
        copy.GetComponent<PlayerProjectile>().SetDirection(facing);
    }
}

// The Inspector half of this lesson is the editor block at the top of the page:
