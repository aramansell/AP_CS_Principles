  finalFile: `using UnityEngine;
using UnityEngine.SceneManagement;

// PlayerController.cs - the jump, complete.
// Everything from 1.4 to 4.4 (input, movement, animation, coins, health)
// stays exactly as you wrote it. The scene check, the key check, the push
// and the one field are the whole of what is new.
public class PlayerController : MonoBehaviour
{
    float speed = 4;                    // your number, from 1.5
    [SerializeField] float jumpForce;  // how hard the flick is - set in the Inspector

    Rigidbody2D rb;
    bool isPlatformer = false;         // which world did I wake up in?

    void Start()
    {
        // Looked up once, never inside Update() - the rule from 2.1.
        rb = GetComponent<Rigidbody2D>();

        // Decided once, for both worlds. Both numbers are written here rather
        // than inherited from the prefab, so the decision is visible to anyone
        // reading this file instead of only to the Inspector.
        Scene currentScene = SceneManager.GetActiveScene();
        if (currentScene.name == "Overworld")
        {
            rb.gravityScale = 0;
        }
        else
        {
            rb.gravityScale = 1;
            isPlatformer = true;
        }
    }

    void Update()
    {
        // ... input, movement and animation, from 1.4 to 4.4 ...

        if (isPlatformer)
        {
            // Gravity owns Y. Writing the full vector here would erase the
            // fall every frame, which is the 2.2 bug wearing new clothes.
            rb.linearVelocityX = speed * Input.GetAxisRaw("Horizontal");

            if (Input.GetKeyDown(KeyCode.J))
            {
                Jump();
            }
        }
        else
        {
            rb.linearVelocity = new Vector2(
                speed * Input.GetAxisRaw("Horizontal"),
                speed * Input.GetAxisRaw("Vertical"));
        }
    }

    // The whole jump. One impulse, and gravity spends it over the next half
    // second - which is why there is nothing here about coming back down.
    void Jump()
    {
        rb.AddForceY(jumpForce, ForceMode2D.Impulse);
    }
}`,
