import Lesson from '../../layouts/LessonLayout.astro';

const body = `<h1>12.2a — Placeholder Jam: Day 1 (topic TBA)</h1>

<p class="lesson-lead">
    The schedule holds two days for a jam whose topic is announced
    by your teacher — a placeholder for whatever the season needs:
    a jam, a portfolio day, a guest, or the year's loose ends. The
    contract below is real for EITHER topic-on-time or a flex day —
    the skills are the same: pick up a constraint fast, and ship.
</p>

<!-- ============================================================ -->
<div class="activity hybrid">
    <div class="activity-header">
        <span class="activity-label">If a topic lands</span>
        <span class="activity-time">~50 min</span>
    </div>

    <p><strong>When the topic IS announced, run the full kickoff
    ritual, compressed to one class:</strong></p>
    <ol>
        <li><strong>Pitch (15 min):</strong> the
            <a href="10.1a.html">10.1a</a> pitch card, written
            FAST — you have done three of these; the sentence
            shapes are muscle memory now: "a ___ where the
            constraint is ___"</li>
        <li><strong>Teams (5 min):</strong> 1–3, everyone codes,
            same rules as every jam</li>
        <li><strong>Core loop (30 min):</strong> the
            <a href="10.1b.html">10.1b</a> day-one contract —
            verbs working end to end, ugly and playable, one
            lose state. You know this road. Walk it
            faster than September-you could have believed.</li>
    </ol>
    <p>One-day topics deserve one-day scope: ONE verb, ONE
    system, ONE moment. The best one-day jam games are a single
    good sentence executed exactly.</p>
</div>

<!-- ============================================================ -->
<div class="activity hybrid">
    <div class="activity-header">
        <span class="activity-label">If the day flexes</span>
        <span class="activity-time">~50 min</span>
    </div>

    <p><strong>When the day becomes flex, the portfolio wins.</strong>
    Pick from the flex menu (or propose your own to the teacher):</p>
    <ul>
        <li><strong>Portfolio day:</strong> your
            <a href="../projects.html">projects page</a> wants a
            real entry for each jam: screenshot, one-paragraph
            pitch, the retro's best sentence, a play link if you
            built one (<a href="10.1e.html">10.1e</a> builds can
            go on itch.io — free hosting, real audience)</li>
        <li><strong>Unfinished business:</strong> the one jam game
            that deserved polish it never got. One hour, three
            10-minute items (<a href="10.1e.html">10.1e</a>
            rules), tagged and shipped</li>
        <li><strong>The pitch you never built:</strong> one jam
            day is exactly enough for a tiny version of the idea
            that lost the vote in
            <a href="12.1a.html">12.1a</a> or
            <a href="10.2a.html">10.2a</a> — build it for
            yourself, no showcase, no votes</li>
        <li><strong>Read-ahead:</strong> tomorrow
            (<a href="12.2b.html">12.2b</a>) closes the YEAR —
            read its retro questions now and bring answers</li>
    </ul>

    <div class="tinker">
        <h3>Tinker: Whatever you pick</h3>
        <ol>
            <li>Commit something before you leave. A flex day that
                ends with no push was a nap.</li>
        </ol>
    </div>

    <div class="socratic">
        <h3>Reflect: the menu choice</h3>
        <p>
            What did you pick today and why — and if the topic had
            landed instead, which of your jam skills from
            <a href="10.1a.html">10.1a</a> through
            <a href="12.1e.html">12.1e</a> would you have reached
            for first?
        </p>
    </div>
    <div class="checklist">
        <h3>Checkpoint — before moving on, you must be able to:</h3>
        <ul>
            <li>If topic: pitch → team → core loop in one class</li>
            <li>If flex: name what you chose and show the commit</li>
            <li>Either way: leave with something pushed and one
                thing to hand tomorrow's retro</li>
        </ul>
    </div>
</div>

<!-- ============================================================ -->
<div class="resources">
    <h3>Reference Docs</h3>
    <p>Need a deeper explanation? These pages cover the same concepts:</p>
    <ul>
        <li><a href="../docs/unit-12/index.html">Unit 12: Season 2</a> — the flex-day menu</li>
        <li><a href="../projects.html">Projects</a> — the portfolio the flex day serves</li>
    </ul>
    <p>Next: <a href="12.2b.html">12.2b — Placeholder Jam: Day 2 + Year Retro</a> — the last B day.</p>
</div>`;
