import Lesson from '../../layouts/LessonLayout.astro';
import { renderAskBanner } from '../../lib/walkthrough';
import { renderDecompose } from '../../lib/decompose';
import type { DecomposeSpec } from '../../lib/decompose';

// The two recurring questions, asked of a climb. Level 3, so every part is
// named and sourced and what each one DOES is the student's to work out — the
// renderer withholds `does` and asks for it in writing, which is why both
// fields are authored here.
//
// Five parts, because that is what a ladder honestly is: a zone, the flag the
// zone writes, the rule the flag changes, the input that only means something
// inside the state, and the argument with 6.3's gravity branch that decides
// whether any of the rest of it works. Four of the five are shapes this
// student has already typed somewhere in Units 1-7.
const DECOMPOSE: DecomposeSpec = {
  big:
    'Make the character climb. A ladder is not a thing you collide with — it is a place where the ' +
    'normal rules stop applying for a while. So the whole feature is: build a volume that knows you ' +
    'are inside it, let that knowledge change what gravity and your input mean, and then put ' +
    'everything back exactly as it was the moment you step off.',
  parts: [
    {
      name: 'Cut a zone the trigger can see',
      does:
        'An empty GameObject over the ladder strip with a **Box Collider 2D** and **Is Trigger** ticked, tall enough to cover the whole climb, carrying a tag of its own. A trigger is a volume the physics engine reports to you without pushing anything out of it — you get the message and keep your momentum.',
      doc:
        'the trigger-versus-collision split from 2.1, and the tag ritual you performed on the potion in 2.3',
      href: '2.3.html',
    },
    {
      name: 'Turn the zone\'s two messages into one flag',
      does:
        '`OnTriggerEnter2D` sets the flag, `OnTriggerExit2D` clears it, and one `bool` at class scope is the whole of the memory. Nothing else in the project is allowed to write it — the flag is a fact about where you are standing, not a decision you get to make.',
      doc:
        'the coin\'s `OnTriggerEnter2D` in 2.1, and the `bool` you declared for the first time in 5.1',
      href: '2.1.html',
    },
    {
      name: 'Take gravity away while the flag is up',
      does:
        'One branch on the flag that sets `gravityScale` to `0f`, and — the half that is easy to get wrong — hands the number back to the value 6.3 cached when the flag drops, rather than to a literal you typed. A typed literal is a fact about today; the cached value is a fact about this body.',
      doc:
        'the `gravityScale` branch in 6.3, and the `rb.gravityScale` row of the Unity + C# Quick Reference',
      href: '6.3.html',
    },
    {
      name: 'Read the vertical stick, ignore the sideways one',
      does:
        'While the flag is up, the vertical axis drives `linearVelocity` directly and the horizontal axis is not read at all. One set of keys, a second meaning, chosen by where the character is standing — and the movement method is the one you picked in 2.2, not a new one.',
      doc: 'the movement method you settled on in 2.2, and the input axes from 1.4',
      href: '2.2.html',
    },
    {
      name: 'Decide which gravity rule gets to win',
      does:
        '6.3 already writes `gravityScale` on the physics clock, from your vertical velocity. The climb has to be the branch that runs **instead of** that one — not a second line beside it — or the fall multiplier is put back before the frame is ever drawn, and the ladder becomes a slow slide.',
      doc:
        'the `FixedUpdate()` gravity branch in 6.3, and the frame-versus-physics-step split from 1.3',
      href: '6.3.html',
    },
  ],
  why:
    'The split is not five equal problems. Four of them are shapes you have already typed: a trigger ' +
    'that reports a tagged object (2.1), a `bool` that remembers something (5.1), a movement line ' +
    'that writes `linearVelocity` (2.2), and a gravity branch (6.3). Only one idea here is new, and ' +
    'it is the reason the lesson exists. Until today every value in your script described **how ' +
    'much** — a speed, a force, a fall multiplier. The climb flag describes **which rules apply**, ' +
    'and it changes the meaning of two numbers you already own without touching either of them. That ' +
    'is what a state is, and it is why the last part of the split is an argument about order rather ' +
    'than a line of code.',
  sizeTest:
    'The test: could you look this part up on its own, right now, in one search? "Make the player ' +
    'climb a ladder" cannot be looked up. "Set gravityScale to zero while a bool is true" can — and ' +
    'the page you land on also tells you which body type it applies to, and what a Static body does ' +
    'with the number instead. If a part is small enough to search for, the split is finished.',
  turns: [
    'Name the single number the climb and the fall-speed rule both want to own, and say which piece of code writes it last. Then say what the player sees when you get that order wrong.',
    'The climb throws the sideways input away. Name a moment in your own level where that would be the wrong call, and say what the player would feel instead.',
    'Your jump is an impulse — one flick of force — and the climb writes a velocity. Say why an impulse is the wrong tool on a ladder.',
  ],
};

const body = `<h1>7.3 — Ladders I: The Climbing State</h1>

<p class="lesson-lead">
    Go and look for a ladder. Search the project for a sprite, a tile, a prefab, an animation
    clip — search the word itself. The word finds nothing, and that is the trap: there is no
    ladder <em>prefab</em>, no <em>climb animation</em> and no <code>Ladder</code> tag anywhere
    here. There <em>is</em> art, sliced into the cave tileset and filed under a number. So the
    ladder splits in two: a <em>look</em> you paint from tiles you already know
    (<a href="7.1.html">7.1</a>), and a <em>mechanic</em> — a state in which the character may
    ignore gravity. The mechanic is the work.
</p>

${renderAskBanner('how do I climb a ladder?', 3)}

${renderDecompose('7.3', DECOMPOSE, 3)}

<!-- ============================================================ -->
<div class="activity discovery">
    <div class="activity-header">
        <span class="activity-label">In the Editor</span>
        <span class="activity-time">~25 min</span>
    </div>

    <p>
        Confirm the situation before you design around it. <strong>Project window →</strong>
        search <code>ladder</code>, then <code>climb</code>; <strong>Project window →
        <code>Assets/Artwork/Character/Player/</code> →</strong> open the Player's Animator
        controller and read its states. Four things to check, and the first is why this page has
        a trap in it:
    </p>

    <table>
        <tr><th>What you might expect to find</th><th>What is actually there</th></tr>
        <tr>
            <td>A ladder sprite or tile</td>
            <td><strong>It is there, and it is numbered.</strong> <code>MainLev2.0.png</code> is sliced into 1,829 tiles called <code>MainLev2.0_0</code> through <code>MainLev2.0_1828</code>, so the word "ladder" is printed on none of them. The rung column is <code>MainLev2.0_1375</code> (the head) with <code>_1422</code>, <code>_1468</code> and <code>_1514</code> below. This is <a href="7.1.html">7.1</a>'s lesson in one search: the art exists, the <em>name</em> does not.</td>
        </tr>
        <tr>
            <td>A ladder prefab</td>
            <td>Nothing. The project's prefabs are the Player, Coin, Spikes, Axe Item, Switch, Turret, Turret Projectile and Mobile Enemy.</td>
        </tr>
        <tr>
            <td>Climb frames on the character</td>
            <td>Nothing. The Player's controller holds three motions — Idle, Walk and Shovel_Swing — each in Up, Horizontal and Down variants. No climb state, no climbing poses in any character sheet.</td>
        </tr>
        <tr>
            <td>A "Ladder" tag</td>
            <td>Nothing. The tags are Coin, Enemy, Axe, Spikes, Ground and GroundCheck.</td>
        </tr>
    </table>

    <p>
        So the ladder is yours to build, and it splits cleanly in two. The <strong>look</strong> is
        a painting problem and you have a tileset. The <strong>mechanic</strong> is the part that
        has never existed here: a <em>state</em> your player can be in that is neither walking nor
        falling, entered only because a trigger said so.
    </p>

    <table>
        <tr><th>Movement state</th><th>Gravity</th><th>Which input drives it</th><th>What it looks like</th></tr>
        <tr>
            <td>Top-down (Overworld, <a href="5.3.html">5.3</a>)</td>
            <td>None — the world has no down</td>
            <td>WASD, four directions</td>
            <td>The Walk states, driven by <code>WalkDir</code></td>
        </tr>
        <tr>
            <td>Grounded (Platformer, <a href="6.1.html">6.1</a>)</td>
            <td>Tuned with <code>gravityScale</code></td>
            <td>A/D sideways, Space to jump</td>
            <td>Idle or Walk, driven by <code>IsWalking</code></td>
        </tr>
        <tr>
            <td><strong>Climbing (new today)</strong></td>
            <td><strong>None — the ladder owns gravity</strong></td>
            <td><strong>W/S only; sideways is ignored</strong></td>
            <td><strong>Whatever you decide — see <a href="7.4.html">7.4</a>. A held pose is honest for now.</strong></td>
        </tr>
        <tr>
            <td>Airborne (<a href="6.2.html">6.2</a>, <a href="6.3.html">6.3</a>)</td>
            <td>Tuned, with the fall multiplier</td>
            <td>Limited — mostly your own momentum</td>
            <td>Nothing dedicated; the character just moves</td>
        </tr>
    </table>

    <p>
        Build the clicks first. Every step names its pane; the third is a real design decision,
        so read all three options before choosing.
    </p>

    <ol>
        <li>
            <strong>Window ▸ 2D ▸ Tile Palette →</strong> open the <code>Caves</code> palette from
            <a href="7.1.html">7.1</a> and drag three rungs into it from
            <code>CavesTileSet/</code>: <code>MainLev2.0_1422</code>, <code>_1468</code> and
            <code>_1514</code>. The head, <code>MainLev2.0_1375</code>, is already in the tray —
            put it on top and you have a four-tile ladder. <strong>Scene view →</strong> paint it
            one tile wide, floor to ledge. Invent your own from the vine tiles if you like: the
            mechanic does not care what the picture is, which is why the picture is the small
            half of this problem.
        </li>
        <li>
            <strong>Hierarchy →</strong> create an empty GameObject over the strip and name it
            something you would want to find in three weeks. <strong>Inspector →</strong> give it a
            <strong>Box Collider 2D</strong> with <strong>Is Trigger</strong> ticked, sized to the
            strip's full height. Then <strong>Edit ▸ Project Settings ▸ Tags and Layers →</strong>
            create a <code>Ladder</code> tag — the ritual from the potion in
            <a href="2.3.html">2.3</a> — and assign it.
        </li>
        <li>
            <strong>Inspector → the zone →</strong> decide which tilemap the picture lives on, and
            defend it. Three options, and they are not equivalent:
        </li>
    </ol>

    <table>
        <tr><th>Where you paint it</th><th>What happens when you climb</th><th>The cost</th></tr>
        <tr>
            <td>On <code>No Collision</code>, the picture-only tilemap</td>
            <td>The player passes cleanly through and rises the whole height. Simplest possible interaction.</td>
            <td>The ladder is not solid at all — the player can also walk through it sideways at the bottom.</td>
        </tr>
        <tr>
            <td>On a <em>new</em> tilemap child (renderer only, no collider), so the ladder art groups and can be found later</td>
            <td>Same as above, but the ladder is a named object you can select and reuse.</td>
            <td>One more tilemap to track, and you must remember it has no collider.</td>
        </tr>
        <tr>
            <td>On <code>Collision</code>, the solid tilemap, with the zone in front of it</td>
            <td>The player is stopped by their own ladder and cannot climb it at all.</td>
            <td>Fatal as described — unless you leave a one-tile channel beside it, which changes the level.</td>
        </tr>
    </table>
</div>

<!-- ============================================================ -->
<div class="activity basic-app">
    <div class="activity-header">
        <span class="activity-label">In the Code</span>
        <span class="activity-time">~35 min</span>
    </div>

    <p>
        The code is the smallest script in the unit. Answer the two specifications in writing
        first: they are the whole design, and the code afterwards is transcription.
    </p>

    <div class="callout">
        <strong>Architectural specification: the ladder zone.</strong>
        <ul>
            <li>What does the zone carry that lets your script recognise it? Need a new tag, or can you reuse one of the six? If a new one, name it exactly.</li>
            <li>Which two messages does the zone send, and what type is the parameter each hands you?</li>
            <li>Is the zone a trigger or a solid? What happens to the player if you forget that checkbox — and would any error message tell you?</li>
            <li>Which single field on the player does the zone write? Name it and name everything that reads it — a flag read by nobody is decoration.</li>
            <li>The zone is invisible. What is the player actually looking at when they decide to climb?</li>
        </ul>
    </div>

    <div class="callout">
        <strong>Architectural specification: the climb state.</strong>
        <ul>
            <li>What is <code>climbSpeed</code>, what type is it, how is it exposed as a tuning knob, and why slower than walking?</li>
            <li>Which component's gravity is switched off, and to what value? Where does the number come from when you switch it back on — a literal you type, or a value you cached in <a href="6.3.html">6.3</a>? Justify your answer.</li>
            <li><a href="6.3.html">6.3</a> already assigns <code>gravityScale</code> on the <em>physics</em> clock, once per physics step, from your vertical velocity. If your climb branch sets it to zero in <code>Update()</code> and 6.3's branch sets it back, which wins? Predict, test, describe the symptom.</li>
            <li>Your movement is the method you settled on in <a href="2.2.html">2.2</a> — <code>linearVelocity</code> on a <strong>Dynamic</strong> body. What does it need in order to move the player straight up a ladder, and why does that velocity line carry no <code>Time.deltaTime</code>?</li>
            <li>What exits the climb state? List them — the top, jumping, dying, leaving the zone — and say which happen through the trigger and which need handling by hand.</li>
        </ul>
    </div>

    <ol>
        <li>
            <strong>Project window → <code>PlayerController</code> →</strong> add the flag and the
            speed knob, then write the two callbacks the zone sends. This is four lines of
            behaviour, and the whole difficulty is in the <em>else</em> branch where you restore
            gravity. Do that first, before any climbing movement, and test it:
            <strong>Game view → press Play</strong>, walk into the zone, and confirm the flag flips
            by printing it with <code>Debug.Log()</code>. The HUD from <a href="5.3.html">5.3</a>
            lives in <code>Start</code> (index 0) and reads only your stats — it is not in this
            scene, so a climbing experiment reports through the Console.
        </li>
        <li>
            <strong>Same file → the Platformer branch of <code>Update()</code> →</strong> add the
            climb lane: gravity off, vertical input read, sideways ignored, movement done <em>by
            the method you chose in <a href="2.2.html">2.2</a></em>. Press Play and climb. Then let
            go and watch — and be honest about whether the result is what you intended.
        </li>
    </ol>

    <div class="callout trap">
        <strong>The bug you are about to create, and the two ways out.</strong> Jump off the
        ladder while your body is still inside the trigger. You clear the flag by hand so you can
        jump — but you never left the zone, so it never sends its exit message. Land, step back
        on, and nothing happens: the ladder is dead precisely where it used to work. Two standard
        repairs; pick one and justify it:
        <ul>
            <li><strong>A cooldown.</strong> Ignore the zone for a fraction of a second after a deliberate exit. Simple, and it stops a jump from instantly re-grabbing the ladder.</li>
            <li><strong>Trust only the zone.</strong> Never set the flag by hand: let the exit message be the only thing that clears it, and gate the jump on <code>isOnLadder &amp;&amp; jumpPressed</code>. Cleaner in principle; the jump feels one frame late.</li>
        </ul>
        Whichever you pick, write down what the player feels.
    </div>

    <div class="socratic">
        <h3>Socratic: What Kind of Thing Is a Ladder?</h3>
        <ol>
<li>The ladder has art, but no prefab, no climb animation and no tag. Which of those four is a painting job and which one is the engineering — and why does the art being nearly free not make today easy?</li>
<li>The trigger zone sets a flag on entry and clears it on exit. The lever from <a href="5.2.html">5.2</a> flips a value and keeps it forever. Why is a ladder remembered only while you are inside it, and a lever remembered permanently?</li>
<li>Climbing turns gravity off. Your character also had gravity at zero in the Overworld, in <a href="5.3.html">5.3</a>. One number, two meanings, two scenes. What does each mean — and why is "gravity zero" a fact about the state rather than about the world?</li>
<li>Your jump is an impulse and gravity was tuned in <a href="6.1.html">6.1</a> to make the arc feel right. If the climb sets <code>gravityScale</code> to zero and restores it, what is the danger of restoring a number you typed rather than the one you saved?</li>
</ol>
    </div>
</div>

<!-- ============================================================ -->

<div class="checklist">
    <h3>Checkpoint — before moving on, you must be able to:</h3>
    <ul>
        <li>Name the four tiles a ladder is cut from, and why searching for "ladder" finds none of them</li>
        <li>Say which ladder tiles were already on the <code>Caves</code> palette and which you dragged in</li>
        <li>Build a trigger zone with its own tag, and say why it must be a trigger</li>
        <li>Explain climb as a state: gravity off, vertical input only, a deliberate restore</li>
        <li>Say which gravity assignment wins in your build — 6.3's physics-step one or your climb branch — and how you know</li>
        <li>Demonstrate the jump-off re-entry bug and defend the repair you chose</li>
        <li>Explain one input axis serving three meanings, chosen by state</li>
        <li>Commit and push</li>
    </ul>
</div>

<!-- ============================================================ -->
<div class="resources">
    <h3>Reference Docs</h3>
    <p>Need a deeper explanation? These pages cover the same concepts:</p>
    <ul>
        <li><a href="../docs/unit-07/index.html">Unit 7: Level Building &amp; Ladders</a></li>
        <li><a href="../docs/unit-04/enemy-state-machines.html">Enemy State Machines</a> — states, all the way down</li>
        <li><a href="../docs/reference/unity-csharp-quickref.html">Unity + C# Quick Reference</a> — triggers, gravityScale and Rigidbody2D bodies</li>
    </ul>
    <p>Next: <a href="7.4.html">7.4 — Ladders II: Mounts, Tops &amp; Polish</a>.</p>
</div>`;
